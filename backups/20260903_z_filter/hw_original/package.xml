<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pointcloud_z_filter</name>
  <version>0.0.1</version>
  <description>
    按"相对飞机当前高度"的窗口过滤PointCloud2，只给地面站/RViz显示用，
    不改动原始话题。封闭空间飞行时天花板点云会挡住俯视图，这个包把超出
    窗口的点滤掉后发到新话题，避障用的原始点云不受影响。
  </description>
  <maintainer email="todo@todo.todo">todo</maintainer>
  <license>TODO</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
