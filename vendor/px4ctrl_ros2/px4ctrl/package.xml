<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>px4ctrl</name>
  <version>0.0.0</version>
  <description>
    A ROS2(Humble)版 package to control multi-copters using PX4 platform.
    从Fast-Drone-250/src/realflight_modules/px4ctrl(ROS1/catkin)逐行移植而来，
    控制算法本体(controller.cpp)未改动，主要改造集中在节点/订阅/发布/服务调用/
    参数声明这些ROS1到ROS2的胶水层。
  </description>
  <maintainer email="iszhouxin@zju.edu.cn">uav</maintainer>
  <license>GPLv3</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>quadrotor_msgs</depend>
  <depend>uav_utils</depend>
  <depend>Eigen3</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
