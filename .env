# docker compose 会自动读取这个文件里的变量去填 docker-compose.yml 里的
# `${VAR:-默认值}`，不需要调用 docker compose 的那个shell自己手动export——
# 这正是2026-09-14这次事故的根因：docker-compose.yml里`LOCALIZATION_SOURCE`
# 自己的默认值是`uwb_slam`（给这个仓库其它实验场景用的），2026大赛这个任务
# 明确要用`uwb_imu`（房间太大，DLIO/FAST-LIO2这类真实SLAM在这个场地下会
# 失效，方案见docker_sim/2026大赛任务系统全流程任务仿真实现方案.md）——
# 之前一直靠"调用docker compose时手动在shell里export"这三个变量撑着，
# 某次`docker compose up -d`重建容器时执行环境里没有这几个export，直接
# 悄悄回退成了默认值，全程没有任何报错提示，直到复盘定位追了很久才发现。
# 用户2026-09-14明确要求把这三个值固定成这个项目的默认值，此后不管是
# 谁、用什么shell调用docker compose，都会自动带上，不用再记得手动export。
LOCALIZATION_SOURCE=uwb_imu
PLANNER=ego_planner
CONTROLLER=pt4ctrl

# 用户2026-09-14要求：以后所有测试都要能看到Gazebo/RViz画面，不要在
# 后台悄悄跑。默认值本来是false（给纯后台自动化场景用），这里固定成true。
USE_GAZEBO_GUI=true
USE_RVIZ=true

# 用户2026-09-14要求：ego_planner的局部感知窗口从15米（半宽，实际30x30米）
# 改成40x40米（半宽20.0）——排查D3实测"飞机径直撞上obstacle_cylinder"时
# 发现这个值原来被改成跟fsm/planning_horizon(15米)完全相等，规划视野跟局部
# 感知窗口之间没有留任何余量（跟upstream默认"规划视野7.5>局部窗口5.5"
# 这个比例方向正好相反），见DEBUG_JOURNAL.md 2026-09-14相关记录。缓冲区
# 尺寸（map_size_x/y，60x60x5米）不是这个环境变量控制的，是
# src/ego_planner_bridge/launch/ego_planner_docker_sim.launch.py里的硬编码
# 默认值，已经直接改了那份文件。
EGO_LOCAL_UPDATE_RANGE_XY=20.0

# 2026-09-25：dist0 1.5 -> 1.0（三档实测对比后定的值）。
# 物理含义：obstacles_inflation(0.6) 是规划器认定"不能待"的硬边界，dist0 是硬边界
# 之外的软缓冲，真实净空 = 两者之和。
#   1.5（净空2.1m）：障碍圆柱(7,2)到东墙只有2.75m、零代价需要4.2m，东侧通道全程
#                    带代价，优化器只能往西绕——实测编队第二段甩出2~5米，而且同
#                    参数两次绕法能差一倍（双稳态，不可复现）。
#   1.0（净空1.6m）：实测东绕1.17m，离圆柱表面还有0.90m，全程正常。选这个。
#   0.6（净空1.2m）：软缓冲太薄，飞机正对障碍推进时来不及被推开，会压到0.85m的
#                    膨胀硬边界上——一旦飞机自身落进膨胀区，ego-planner 的
#                    rebound_optimize() 直接拒绝规划且无脱困行为，规划器死锁
#                    （详见 DEBUG_JOURNAL.md 2026-09-25）。定向复现4次中3次卡死。
EGO_DIST0=1.0
