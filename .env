# docker compose 会自动读取这个文件里的变量去填 docker-compose.yml 里的
# `${VAR:-默认值}`，不需要调用 docker compose 的那个shell自己手动export——
# 这正是2026-09-14这次事故的根因：docker-compose.yml里`LOCALIZATION_SOURCE`
# 自己的默认值是`uwb_slam`（给这个仓库其它实验场景用的），2026大赛这个任务
# 明确要用`uwb_imu`（房间太大，DLIO/FAST-LIO2这类真实SLAM在这个场地下会
# 失效，方案见docker_sim/2026大赛任务系统全流程任务仿真实现方案.md）——
# 之前一直靠"调用docker compose时手动在shell里export"这三个变量撑着，
# 某次`docker compose up -d`重建容器时执行环境里没有这几个export，直接
# 悄悄回退成了默认值，全程没有任何报错提示，直到复盘定位追了很久才发现。
# 用户2026-09-14明确要求把这三个值固定成这个项目的默认值，此后不管是
# 谁、用什么shell调用docker compose，都会自动带上，不用再记得手动export。
# 2026-10-13 用户要求：仿真 odom 一律用 Gazebo 真值。
# 原来是 uwb_imu（UWB+IMU 互补滤波替代 SLAM），那条链有两个实测问题：
#   · 位置噪声 σ=0.05 m 在 50 Hz 上微分出 0.2 m/s 量级的速度噪声；
#   · z/vz 在测距雷达读数不新鲜时**按设计**退回纯 IMU 积分、自由漂移
#     （uwb_imu_fusion_node 的 range_fresh 判断）——实测两机真静止时
#     odom 报 |v|=0.037（NX01）/ 0.165（NX02），真值都是 0.000。
# gt 模式直接订阅 Gazebo model_states，零噪声零漂移。真机那边仍是 uwb_imu
# （gt 在 DEPLOY_TARGET=hw 下有 fail fast，本来就只能仿真用）。
# 2026-10-13 从 gt 改回 uwb_imu。gt 那条喂 PX4 的路是 repub_odom，**不设协方差**，
# 而 EKF2_EV_NOISE_MD=0 要求用消息里的协方差——实测 EKF2 发散到几百米
# （PX4 报 (-460,-151) 而真值 (10.85,2.86)），飞机被喂发散状态，撞墙趴地。
# uwb_imu 那条路的 uwb_imu_fusion_node 显式设 yaw/roll_pitch/position 协方差，
# 已经飞了几个月。噪声已经全部归零，所以 uwb/pose_abs 就是 Gazebo 真值直通，
# "odom 用真值"这个要求照样满足。
LOCALIZATION_SOURCE=uwb_imu

# [s] 全部模型 spawn 完到起 PX4 SITL 之间等物理稳定多久。原来写死 3 秒，不够：
# 最后一个 spawn 的飞机（NX02）会把还在晃的 IMU 读数当加速度计零偏烤进 PX4，
# 实测偏置 0.554 m/s² 超过 EKF2_ABL_LIM=0.4 永远修不掉 => 静止时 odom 速度
# 0.29 m/s => pt4ctrl 拒绝非静止起飞。详见 sim-world-entrypoint.sh 同名参数注释。
SPAWN_SETTLE_S=12

# 2026-10-13 关掉起飞前静止判据（用户要求）。
TAKEOFF_STATIC_SPEED_MAX=99.0
TAKEOFF_INSTANT_SPEED_MAX=99.0

# ---- 2026-10-13 用户要求：仿真里不要给任何噪声 ----
# 为什么：uwb_imu 口径下 odom 源是 uwb_imu_odom（UWB 位置经互补滤波），
# 位置噪声 σ=0.05 m 在 50 Hz 上微分出来就是 0.2 m/s 量级的速度噪声，而
# takeoff_monitor_node 的**起飞前静止判据**要求里程计速度均值 < 0.08 m/s。
# 实测 NX02 一直在 0.167~0.229 徘徊、45 秒判定超时、**起飞指令根本没发出去**；
# NX01 是擦着过的（0.085）。两机都在边缘，一个过一个不过。
# 这两项归零之后 uwb/pose_abs 就是 Gazebo 真值直通。
UWB_NOISE_STD=0.0
UWB_YAW_NOISE_STD_DEG=0.0
PLANNER=ego_planner
# 2026-10-16：ego_planner **本体**的开关，独立于 PLANNER。
# 为什么不能直接把 PLANNER 改成别的值：position_cmd_relay_node / line_goto_node
# / pillar_detector_node 全都在 entrypoint 的 `elif PLANNER = ego_planner` 分支
# 里，改 PLANNER 会把它们一起关掉——那是精降和航点飞行的命根子。
# 航线飞行 2026-10-13 起已经全部走 line_goto（goto()/fly_route() 都改了），
# ego_planner 只剩"地面站指点飞行"和避障两个用途，仿真调试时可以关掉省一个
# 满载核（它单线程饱和，两架飞机就是两个核）。
# 2026-10-16 改回 true：关掉它会把 **traj_server** 一起关掉，而 face_yaw() /
# set_yaw_mode_*() 这套原地转向**唯一的执行者就是 traj_server**
# （靠 ego_planner_traj_server_yaw_hold.patch 那条"空闲时收到新朝向就地转"的
# 通路）。实测后果：侦察机在 G 点转向 180° 卡在 90° 不动、每次都等满 15 秒
# 超时才往下走；高层火情在 M 点机头也不转——而那一步必须正对楼面才能瞄准。
# 省 CPU 改走"把地图和分辨率缩小"那条路，见 ego_planner_docker_sim.launch.py。
EGO_PLANNER_ENABLED=true
CONTROLLER=pt4ctrl

# 用户2026-09-14要求：以后所有测试都要能看到Gazebo/RViz画面，不要在
# 后台悄悄跑。默认值本来是false（给纯后台自动化场景用），这里固定成true。
USE_GAZEBO_GUI=true
USE_RVIZ=false   # 2026-10-16 关掉：纯可视化，一份 3D 渲染（CPU+GPU）。
                 # 飞行过程看 Gazebo GUI 和监视器窗口就够，RViz 只在调规划器
                 # 轨迹/点云时才需要，要用就临时改回 true。

# 用户2026-09-14要求：ego_planner的局部感知窗口从15米（半宽，实际30x30米）
# 改成40x40米（半宽20.0）——排查D3实测"飞机径直撞上obstacle_cylinder"时
# 发现这个值原来被改成跟fsm/planning_horizon(15米)完全相等，规划视野跟局部
# 感知窗口之间没有留任何余量（跟upstream默认"规划视野7.5>局部窗口5.5"
# 这个比例方向正好相反），见DEBUG_JOURNAL.md 2026-09-14相关记录。缓冲区
# 尺寸（map_size_x/y，60x60x5米）不是这个环境变量控制的，是
# src/ego_planner_bridge/launch/ego_planner_docker_sim.launch.py里的硬编码
# 默认值，已经直接改了那份文件。
# 2026-10-16 20->8：局部占据图的更新半宽。房间半宽才 10~12 m，20 m 等于每帧
# 刷新整个场地两遍。8 m 足够覆盖 planning_horizon 内的障碍。
EGO_LOCAL_UPDATE_RANGE_XY=8.0
# 2026-10-16 新增（原来只有 compose 里的默认值 15.0）：点云投进占据图时每条
# 射线的最大长度。雷达仿真的量程本身已砍到 1 m（gen_iris_mid360_sdf.py），
# 15 m 纯属空转。
EGO_MAX_RAY_LENGTH=5.0

# 2026-09-26：用"已知立柱注入"补空洞，竖直膨胀保持原值（用户 09-26 指定）。
# 实测对比（高层火情全流程各跑一轮）：
#   注入off/竖直0.1：柱子在飞机同高±0.1m内无点的帧占 4.2%，任务正常
#   注入on /竖直0.1：同一指标 0.0%（每个高度至少9个注入点兜底），任务正常
#   注入off/竖直0.6：同一指标 4.9%（没改善），且自由空间被压缩导致反复
#                    "不可达"——最差的一轮侦察机连三个巡检中点都走不到、
#                    规划器报 "First 3 control points in obstacles" 原地自旋。
#                    注：不是自扫描伪点造成的——悬停实测 2477 点/帧全在 0.4 m
#                    以内、被 min_ray_length 全滤掉，0.4~2.0 m 一个点都没有；
#                    卡住那一帧逐格复算，起点格子空闲、最近占据格在 2.02 m 外，
#                    真正原因尚未定案（见 DEBUG_JOURNAL 2026-09-26）。
STATIC_OBSTACLES_ENABLED=true
# （旧值 0.1 已被下面 2026-09-28 那条 0.2 取代，留注释避免再出现重复定义）

# 2026-09-28：把 (7,2) 那根 r=0.25 的圆柱也加进注入列表。
# 起因：编队飞行时长机直穿它坠机，规划器全程 no_collision_segment——
# 实测 8~12 米处有 41% 的帧在飞机所在高度层一个点都打不到（圆柱太细，
# 单帧 2 万点铺满 360°×59° 本来就稀）。它跟三根立柱一样是赛场固定障碍，
# 位置尺寸已知，没理由指望雷达每帧都看见。
# 注入按统一的 half=0.5 采样，对 r=0.25 的圆柱偏保守（膨胀边界大 0.25 m），
# 是安全侧。
# 2026-09-29 换成**样题场景**坐标（原点在房间西南角，全正）。老值
# 4.5,7.0,-4.5,7.0,0.0,0.0,7.0,2.0 是 fire_drill_room 的中心原点坐标，
# 在新世界里 x=-4.5 直接落到房间外面——rviz 里"柱子跑到房间外"就是这个。
# 2026-10-11 用户改场景：1#/3# 编号互换、1#2# 沿 +X 移 0.5、3# 沿 -X 移 0.5，
# 并**去掉**那根障碍圆柱（layout 里 obstacle_cylinder.enabled: false）。所以
# 这里从 7 个点变成 6 个点，且 (3.0,8.0) 必须删掉——留着就是在 A->B 航段上
# 给规划器注入一个世界里根本不存在的障碍，飞机会去绕空气。
# 6 根立柱（3 根 + 各自正东孪生柱），按 1#/2#/3# 顺序：
#   1# (6.0,12.5)(7.0,12.5)  2# (6.0,19.5)(7.0,19.5)  3# (13.0,19.5)(14.0,19.5)
# 权威来源：src/contest_mission/config/sample_room_layout.yaml
STATIC_OBSTACLES_XY=6.0,12.5,7.0,12.5,6.0,19.5,7.0,19.5,13.0,19.5,14.0,19.5

# 2026-09-28：竖直膨胀 0.1 -> 0.2 m。依据是实测算出来的传感器分辨率：
# 单帧 2 万点铺满 360°×59°（约 5.72 球面度）→ 平均角间距约 0.97°，
# 10 米外竖直点间距约 0.17 m。而膨胀只有 ±0.1 m 时，"飞机同高 ±0.1 m"
# 这个窄带在 10 米处只张 0.57°，比点间距还小——统计上期望 0~1 个点，
# 实测 8~12 米处 41~51% 的帧一个点都没有。膨胀半径至少要覆盖传感器
# 自身的点间距，0.2 就是按这个取的（之前试过 0.6，跳太大，出现过
# "起点在障碍里"把飞机困住，见 09-26 记录）。
EGO_OBSTACLES_INFLATION_Z=0.2

# 2026-09-28：启用定期多项式重置初值（此前一直是 0=关闭，从没实测过）。
# 每次重规划都拿上一条轨迹当初值，而代价函数里没有长度/转角项，绕出来的弯
# 会被一路继承（实测有 cost=0.048 len=16.66m turn=425° 这种）。定期重置切断
# 这条链。重置只在"起点到局部目标的直线在膨胀图上是通的"时候才真的发生，
# 绕障中途不会触发，所以不会引起换边拐一下。
# 2.0 秒的依据：航段多在 10~20 秒，任何一个弯最多存活 2 秒≈2 米航程；
# 重规划约 6~7 Hz，重置后还有十几次重规划能把新种子优化透。
# 2026-09-28 几经反复，最后定 3.0（用户决定）：
# ① 先按 2.0 试，看转角统计像是没收益、反而更糟（turn>=180° 29%->39.5%，
#    最大累计转角 534°->988°），于是关掉；
# ② 关掉之后出现新的失效形态——长机在直线航段上轨迹拧成麻花（一条 11 m 的
#    段累计转角 276°~450°，且 initCP 报 no_collision_segment，根本不是在绕障），
#    飞机顺着麻花爬行，1.3 秒只走 0.37 m，SDK 判卡死中止任务（run39/run41）。
#    每次重规划只在上一条轨迹上继续优化，拧成麻花就再也解不开。
# 结论：转角统计变差是表象，能不能解开麻花才是要害。3.0 秒比原来的 2.0 稍长，
# 少打断正常优化，又保证任何一条坏轨迹最多存活 3 秒≈3 米航程。
# [s] 多久强制用多项式重置一次 B 样条初值（0=关）。见 patches/ego_planner_poly_reset.patch。
# 2026-10-12 试过 0.5，实测**无效**：A->B 横偏峰值 1.62 -> 1.96 m，反而略差（launch 里
# 那段注释早写了"太短 <1s 会一直在用没优化透的初值，反而更差"）。原因见下面
# EGO_ALIGN_START_STATE：poly_reset 只换初值种子，换不掉锁在**边界条件**里的横向
# 残速——B 样条前 3 个控制点由起点位置/速度/加速度唯一确定，根本不是优化变量。
# 已回滚回 3.0。
EGO_POLY_RESET_PERIOD_S=3.0

# 起点速度/加速度投影到"起点->局部目标"方向、清掉横向分量（配合
# patches/ego_planner_align_start_state.patch）。false=关闭，行为不变。
# 2026-10-12 实测的病因：长机以 1.25 m/s 冲进 A(3,3)，减速距离不够过冲到 x=2.35，
# 回拉修正时甩出 +0.27 m/s 的**横向**速度，带着它进入 A->B 段。这股速度被锁进
# B 样条前 3 个控制点（优化变量从 start_id=order_=3 才开始），优化器无权修改，
# 于是轨迹被甩到 x=4.96、用了 19 米才摊回 x=3，横偏峰值 1.96 m。同期 B->C /
# C->G / G->D 三段横偏都 <= 0.52 m——进那些点时长机已在编队巡航、末端减速到位，
# 残速很小。
# 排除过的做法：改 A*（无障碍段根本不调用 A*，只在碰撞片段里搜）、poly_reset
# （换种子不换边界条件）、只留平滑度（min-jerk 的解本来就不是直线，去掉 fitness
# 反而更舍不得用 jerk 快速修正）、令 jerk≡0（控制点变二次多项式=抛物线，代入
# 实测起点算出来峰值 2.81 m，比现状还差 43%）。
# 开启后那点横向速度改由 pt4ctrl 在一两秒内吃掉，而不是让规划器用 19 米去磨。
EGO_ALIGN_START_STATE=true
# [m/s] 横向分量超过它就**不**对齐——说明飞机确实在做横向机动（刚拐弯、正绕障），
# 硬清零会让期望速度跳变太大，控制器吃不下反而更糟。
EGO_ALIGN_MAX_LAT_VEL=0.5

# EGO_LOCK_TO_LINE：梯度投影锁直线（ego_planner_lock_to_line.patch）。
# align_start_state 让**初值**成为精确直线（min-jerk 两端边界条件共线 ⇒ 路径是
# 直线；均匀 B 样条控制点共线 ⇒ 曲线共线），但优化器仍可把控制点往横向推，剩的
# 0.17 m 横偏就是这么来的。本开关把每个控制点的梯度投影到弦方向、横向清零，
# 横向自由度直接消失 —— 航点之间的轨迹恒等于连接两点的那条直线；两端等高时
# 弦是水平的，z 自由度一并消失，所以是**水平直线**。
# ⚠️ 锁住期间没有横向避障。四道门任一不过就自动不锁、退回完整 ego-planner：
#    ①开关关 ②弦<EGO_LOCK_MIN_LEN ③初值不共线(>EGO_LOCK_MAX_INIT_DEV) ④直线被占据。
#    撞上障碍/僚机过近时也会当场解锁（日志 [lock_line] 会说明原因）。
EGO_LOCK_TO_LINE=true
EGO_LOCK_MAX_INIT_DEV=0.15
EGO_LOCK_MIN_LEN=0.5

# ---- 2026-10-13 定位口径：UWB 绝对系（跟真机同口径）----
# odom 的数值本身就是 UWB 全局坐标：uwb/pose_abs(frame_id='world') -> EKF2 ->
# mavros/local_position/odom -> local_position_readback_node（只换标签、不改数值）
# -> dlio/odom_node/odom。于是 world -> {ns}/odom 发恒等静态 TF，
# SDK 的 world_to_local()/local_to_world() 退化成恒等，不起 origin_setter_node、
# 不做起飞点锁定、不估那个在线 SE(2) 旋转 θ*。
# 回滚：UWB_GLOBAL_FRAME=false（两项必须一起回滚，见真机 .env 同名项的警告）。
UWB_GLOBAL_FRAME=true

# ⚠️ 2026-10-13 傍晚改回 mavros/local_position/odom（EKF2 输出），别再指向
# uwb_imu_odom。uwb_imu_odom 是 uwb_imu_fusion_node 自己那套互补滤波的输出，
# 它吃 mavros/imu/data_raw（**raw，没做任何加速度偏置补偿**）做纯积分，
# 整个节点里**没有偏置估计这一环**，于是 IMU 水平偏置被直接积成假速度：
#   实测 NX02 静止在 (12.000,3.000)（uwb/pose_abs 8 秒位移 0.000 m、零噪声），
#   uwb_imu_odom 报 |v|=0.292 m/s（按这速度 8 秒该走 2.3 米，实际走了 0.013 米），
#   速度方向 (+0.217,-0.194) 与它自己的稳态位置偏差 (+0.109,-0.104) 同向——
#   速度状态被偏置推飞、位置状态被互补滤波钉回观测，两个状态自相矛盾。
#   同一时刻 EKF2 的 mavros/local_position/odom 只有 |v|=0.056、位置偏差 0.029 m：
#   EKF2 有加速度偏置估计（EKF2_ABL_LIM=0.4）能把它修掉，互补滤波没有。
# 后果：pt4ctrl 拿 {ns}/odom 的速度跟**写死的** 0.1 m/s 比（non-static takeoff
# is not allowed），NX02 连拒 15 次、永远起不来。NX01 **不是好的**，它吃的是
# 同一条脏链路（0.055 vs EKF2 的 0.047），只是偏置小、侥幸压在阈值下面——
# 两机 73 项环境变量只差 AGENT_INDEX/NAMESPACE，所以这从来不是"NX02 有毛病"
# 或 spawn 时序竞态，是这条配置本身选错了源。
# 当初（10-13 上午）改成 uwb_imu_odom 的理由是"EKF2 的输出原点在它自己初始化
# 的地方，不是 UWB 原点，要去掉那层偏移"——**实测否证**：EKF2_EV_CTRL=11 融合
# 的 vision_pose 喂的就是绝对值，EKF2 输出本来就在 UWB 绝对系（NX01 偏 0.023 m、
# NX02 偏 0.029 m），那层偏移是起飞点锁定时代的事，现在不存在。
# 这样也跟真机同口径：真机那份 fusion node 根本不发 uwb_imu_odom。
# 改这一项不用重建镜像（entrypoint 读环境变量）。
ODOM_SOURCE_TOPIC=mavros/local_position/odom

# ---- 2026-10-13 直线航点飞行（line_goto_node），替代 ego_planner 走航点 ----
# 换掉规划器的理由：lock_to_line 那个梯度投影补丁有四道门，任一不过就退回完整
# ego 行为，而且锁住也只是冻住初值横偏（上限 0.15 m），**保证不了直线**。
# 这个节点的直线是结构性的：p(s)=航点+û·s，无优化器/代价函数/地图。
LINE_CRUISE_MPS=0.8
# [m/s²] 起步加速度上限（"缓慢加速"）。0.5 => 0 到 0.8 用 1.6 s、走 0.64 m。
LINE_ACCEL_MPS2=0.5
# [m/s²] 刹车（减速）上限，2026-10-13 从 LINE_ACCEL_MPS2 里拆出来的；0 = 跟它相同。
# 拆开的两个理由：
#   · 速度：梯形剖面每段的代价是 v/a + v/d。巡航 1.0 时 0.5/0.5 => 每段 +4.0 s，
#     0.5/1.0 => +3.0 s。整条 9 点航线省 ~8 s。
#   · 安全（更要紧）：刹车距 = v²/(2·d)。巡航 1.0 时 d=0.5 要 1.0 m、d=1.0 要 0.5 m；
#     --max-vel 提到 2.0 的话 d=0.5 就要 4.0 m，而本场最短航段（E->F）只有 5.32 m,
#     减速区会吃掉整段的 3/4。减速能力本来就比"起步要柔和"这条约束宽。
# 1.0 m/s² ≈ 0.1 g，远在多旋翼能力之内；起步仍按 LINE_ACCEL_MPS2 的 0.5 柔和加速。
LINE_DECEL_MPS2=1.0
# [m/s] 拐点允许的瞬时速度增量上限，拐点限速由它反解：
#   v_corner <= LINE_CORNER_DV_MAX / (2·sin(转角/2))
# 本场航线实测：34°->0.69、90°->0.283、145°(G 折返)->0.21 m/s，接近共线的航点
# 自动不减速。一个参数覆盖所有角度。
# 2026-10-14 0.4 -> 0.3：不停拐点的过弯速度 = DV/(2*sin(转角/2))，
# 90 度角 0.283 -> 0.212 m/s（-25%），治 A/G/D 那几个点 0.40~0.42 m 的过冲。
LINE_CORNER_DV_MAX=0.3
# [m/s] 爬升/下降速率上限。高度按离地走，不限速的话跨上仿地模块时整个 AGL 误差
# 会一拍变成 0.6 m 的位置台阶。
LINE_ALT_RATE_MPS=0.6
# [s] stop_at 标记的航点上停多久。**只对标记了的航点生效**：编队段保留关键航点
# 停留（长机等僚机收间距），单机任务段 SDK 传全 0 = 全程不停。
LINE_DWELL_S=2.0
# [m] 设定点最多领先飞机**弧长**这么多。限弧长而不是直线距离，所以设定点始终
# 精确落在折线上，直线保证不被破坏。沿用 formation_follower_node 的同名值。
LINE_MAX_LEAD_M=1.5
LINE_CMD_RATE_HZ=50.0

# [m/s] precision_servo 的**垂直**速率上限（goto_direct / set_agl /
# return_home 落点精修 / aim_at 平移都走它）。2026-10-13 新增：那个节点的 z
# 一直是裸的——coordinate_max_speed_mps 的夹限只作用在水平两轴，
# cmd.velocity.z 也从来没赋值过。单独一个参数是因为 _direct_leg() 会把水平
# 限速临时提到 1.0 m/s 跑航段，垂直速率不该跟着一起变。
SERVO_MAX_Z_SPEED_MPS=0.6

# [m] 两机**空间直线距离**下限（硬保护）。低于此值僚机参考点冻结等待；0=关。
# 2026-10-12 从真机移植（真机 .env 同名变量也是 4.0，2026-10-08 用户定的：
# 编队间距 5.0 留 1 m 余量）。注意这跟 follow_distance / s_limit_gap 那些"间距"
# 不是一回事——那些都是**沿长机轨迹的弧长差**，长机打圈时弧长飞涨而空间位置
# 不动，真机 2026-10-07 两机相撞时僚机自报弧长间距还有 4.25 m、实际只剩 0.03 m。
# ⚠️ 折线拐点处两机空间距离会被几何压缩到 spacing*cos(转角/2)：当前航线在 E 点
# （转角 131°）理论下界只有 2.07 m（spacing=5.0），所以这道保护在每个拐点都会
# 触发一次"冻结等待"。这是预期行为，先跑一轮量触发频率和总耗时再决定调不调。
FORMATION_MIN_SEPARATION_M=4.0

# [m] ego_planner 单次规划前瞻距离。2026-09-28 从 15.0 改到 8.0（用户决定）。
# 为什么 15 太长：flag_polyInit = have_new_target_ || flag_use_poly_init，而
# have_new_target_ **只在收到新的全局目标时置位**（ego_replan_fsm.cpp:205/789），
# 局部目标沿全局轨迹前移不会重新播种。本场航段 19 m / 14 m，前瞻 15 m 等于
# 每段只有第一次规划带新鲜多项式初值、而那一次就把几乎整段（含 (7,2) 那根柱子）
# 定了型，后面十几次重规划只是在这条轨迹上搓形状，没有纠错机会。
# 8.0 让首次规划的承诺距离降到不足半段，远端也落在雷达看得清的范围内。
# 2026-09-28 又改：8.0 试过，卡死两轮（run39/run41，轨迹拧成麻花）；
# 现在按用户要求拉到 20.0——比最长航段（19 m）还长，等于"一次规划覆盖整段"。
# 2026-10-16 20->10：单次规划看多远。场地对角线才 32 m，而航线段现在都走
# line_goto，ego_planner 只在地面站指点飞行时真正规划，10 m 够用。
EGO_PLANNING_HORIZON=10.0

# [m] 航点队列里中间航点提前多远切换下一个目标（穿越式切换）。
# 2026-09-28 实测 2.0 是净负面，设回 0.0（用户决定）：
#   ① 切角——长机离各航点最近只到 0.98~1.24 m，根本没飞到航点上；
#   ② 想要的收益没拿到——巡航速度中位 0.58 vs 原来 0.59，纹丝不动，
#      说明长机跑不满 1.0 m/s 跟拐点停顿无关；
#   ③ 间距反而更差——僚机跟的是长机实飞轨迹，长机切角后轨迹与航线错开，
#      沿航线间距被压到 1.71 m（原 2.80~5.13）。
# 0.0 = 中间航点也等进到 0.3 m 球内才切，过点不切角。
# 注意"整条航线一次下发"（sdk.goto_route）保留，它本身是对的——省掉了每段
# 之间"goto 返回 -> 重进 fixed_altitude -> 连发新队列"的脚本往返。
# 2026-09-29 实测四档（新场景 A B C G E F G D 航线，爬行=拐点速度<0.3的时长）：
#   半径0.3 V1.0  爬行32.5s 最大切角0.45 巡航0.54 全程183s 间距std0.46 ±1.0内94%
#   半径1.2 V1.0  爬行 5.7s 最大切角1.12 巡航0.60 全程152s 间距std0.63 ±1.0内87%
#   半径2.0 V1.0  爬行 3.1s 最大切角1.46 巡航0.62 全程144s 间距std0.47 ±1.0内98%  ← 选这个
#   半径1.5 V0.8  爬行23.0s 最大切角1.22 巡航0.50 全程183s 间距std0.42 ±1.0内96%
# 机理：规划器给每个航点的轨迹终点速度为零，最后一段是**渐近收敛**，减速尾巴
# 从离航点约 0.5 m 开始（实测最后 0.4 m 爬了 4 秒）。要不爬就得在进入尾巴之前
# 切走，而新目标的轨迹自己也从低速起步，所以 0.8/1.2/1.5 都不够干净。
# 降速没用——尾巴长度跟速度基本无关（是渐近收敛不是动能刹车），V0.8 那档
# 爬行反而涨回 23 秒，只是整段飞得更慢。
# 这是硬取舍：切角小(0.45)只有半径0.3能给，代价 32.5 秒爬行；两者不可兼得。
# 真要兼得得改航线几何（拐点前插提前量航点，让减速分摊到两段），不在这个旋钮里。
# 2026-09-29 用户改要求：每个航点停 2 秒同时换向、航段内航向恒定。
# 既然要**真正飞到**航点，提前切换就没有意义了，设回 0。
WAYPOINT_FLYTHROUGH_M=0.0

# [m/s] 最大飞行速度。2026-09-29 试过降到 0.8 配合切换半径 1.5，实测没有
# 收益（爬行反而 5.7s -> 23.0s，切角也没变小），改回 1.0。见上面那张对照表。
V_MAX=1.0

# ---- 2026-10-14 编队几何基准：僚机飞哪条线 ----
# leader_traj = 沿长机实飞轨迹（旧行为）。长机走 ego_planner 弯曲轨迹的年代，
#   这是僚机**唯一的避障保证**（它在 relay_mode=formation 下绕开了自己的规划器）。
# route       = 直接在航点折线上取点。前提两条，现在都成立：①用户确认不需要避障；
#   ②长机自己也走 line_goto 的结构性直线（横偏均值 0.11 m），"长机实飞轨迹"与
#   "航线折线"本来就几乎重合，跟轨迹反而是在逐点复刻长机的跟踪误差——09-28 复盘
#   记的"拐点冲过头 0.5 m、倒退 2.2 m、悬停 3 s、实飞弧长 20.5 m vs 直线 7.7 m"
#   就是被僚机原样复刻、间距先扎 1.51 m 再窜 6.96 m 的由来。
# ⚠️ 两种基准下"量多远"都走航线弧长（RouteRuler），只有"飞哪儿"在切。
# 退回 leader_traj：route 基准首跑失败——RouteRuler.project() 没做圈数展开，
# 闭合航线(起终点都是 A)+G 点自交导致僚机投影 snap 回 s~0，间距跳到
# 0.076~22.11 m（两机几乎重合）。要重开得先把投影换成 project_unwrapped()。
FORMATION_FOLLOW_BASIS=leader_traj
