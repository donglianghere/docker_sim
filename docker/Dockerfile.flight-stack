# ----------------------------------------------------------------------------
# flight-stack：机载软件侧。DLIO + mighty(规划) + ros2_px4_stack(dynus分支，含
# 三处已知修复：create_rate死锁、自动解锁/切OFFBOARD、lidar_frame_id_硬编码)。
# 跑两份容器实例，一机一个（NX01 / NX02），今后真机部署也是同一个镜像。
#
# 构建：
#   docker build --build-arg HTTP_PROXY=$http_proxy --build-arg HTTPS_PROXY=$https_proxy \
#                 -f docker/Dockerfile.flight-stack -t flight-stack:latest ..
# ----------------------------------------------------------------------------
FROM mighty-base:humble

ARG HTTP_PROXY
ARG HTTPS_PROXY
# 编译并发度：colcon/make 默认都会吃满 nproc，这台机器核数(32)远超内存(31G)，
# sim-world 和 flight-stack 两个镜像又会被 docker compose build 并发构建，
# 核数x核数 x 2镜像 的并发编译直接把内存打爆、系统死机。用 BUILD_JOBS 统一收窄，
# 按 "内存(GB)/2" 估算一个安全值，构建时可用 --build-arg BUILD_JOBS=N 覆盖默认值。
ARG BUILD_JOBS=4
ENV http_proxy=${HTTP_PROXY} \
    https_proxy=${HTTPS_PROXY} \
    DEBIAN_FRONTEND=noninteractive \
    MAKEFLAGS=-j${BUILD_JOBS}

# ============================================================
# 1. DLIO（vectr-ucla, feature/ros2 分支）
# ============================================================
COPY staging/dlio_ws_src /opt/dlio_ws/src
# DLIO 自己的点云订阅用裸整数1构造QoS，默认是RELIABLE；Gazebo那边Livox插件发布点云
# 用的是BEST_EFFORT（sensor数据的常规约定，IMU那行DLIO自己也用了SensorDataQoS，
# 唯独点云这行没有）——RELIABLE订阅者收不到BEST_EFFORT发布者的消息，DDS QoS
# 兼容性规则决定的，导致DLIO压根收不到Gazebo的雷达点云，算不出里程计，`mighty`
# 订阅的state话题因此从来没人真正发布过（`ros2 topic hz`会报"does not appear
# to be published yet"）。改成跟IMU那行一致的 rclcpp::SensorDataQoS()。
# DLIO自己的debug()原来在callbackPointCloud里——每一帧点云回调都触发一次，新起
# 一个detached线程清屏+打印一份完整仪表盘。雷达帧率有多快终端就刷多快（这套
# mid360仿真是100Hz），人眼根本看不清，多个并发线程还会互相抢着清屏/打印导致
# 输出经常整段乱套。限流到最多每1秒打印一次。
# output限流生效之后终于能在崩溃前的最后状态里看清具体数字：飞机静止不动，DLIO
# 却算出"走了两千多米"，accel bias顶到params.yaml里abias_max的上限。查了
# mid360/imu的实际发布规律（`ros2 topic hz`）：平均~470Hz，但min interval显示
# 0.000s（近零间隔的相邻消息）、偶尔还有0.104s的大间隙，非常不规律。odom.cc里
# 有两处"dt作分母"的地方：一处是transformImu()里的杆臂修正项
# `(ang_vel_cg - ang_vel_cg_prev) / dt`，另一处是主IMU回调里存进imu_meas.dt、
# 直接被propagateState()拿去做速度/位置积分的那个dt。两处原来都只挡了
# `dt == 0`这一种情况，挡不住"非零但极小"——极小dt配上仿真里几乎零噪声的IMU
# 读数中偶发的微小抖动，会在除法/积分时被放大成数值尖峰，是DLIO在静止状态下
# 依然发散的一个具体、可验证的推手。两处都改成`dt < 1e-4`的下限钳位。
#
# 2026-08-19新增dlio_propagate_sanity_guard.patch——真机联调实测过一次
# 完全静止状态下速度在单帧内(dt<0.01s)从毫米级跳到>1m/s、紧接着GICP LOST
# TRACK、姿态整个跑飞、最终free(): invalid next size堆损坏、进程SIGABRT
# 崩溃退出的完整链路，具体触发点没有抓到（诊断打印限流1秒一次，跳变发生
# 在两次打印之间）。这是工程化安全网，不是精确定位崩溃根因的修复——给
# propagateState()加两道防线（dt异常大/积分出的速度超过物理合理上限），
# 命中就丢弃这一帧更新、回滚到上一个已知状态，避免失控继续传播到进程
# 崩溃这种最坏结果，背后那个更深层的bug还没有精确定位。
#
# ⚠️ 2026-08-19顺带发现：dlio_extrinsics_mount.patch（给Gazebo仿真里
# mid360.xacro水平安装配置杆臂偏移t=[0,0,0.06]）跟真机专用的cfg/dlio.yaml
# 改动（雷达+IMU一体绕Y轴前倾25°、R改成对应旋转矩阵，t保留上游原始真实
# 硬件标定值不动）冲突——这个patch试图匹配的旧内容已经被真机改动覆盖掉，
# 会在下面的git apply --check这一步静默失败（容错设计是失败只echo警告、
# 不中断build）。这对真机场景反而是"歪打正着"（失败保住了正确的真实硬件t
# 值，没被仿真的t值覆盖），但这是脆弱的巧合状态，不是设计好的行为——
# 如果以后cfg/dlio.yaml的内容变动、这个patch重新变得可应用，会静默地把
# 真机的杆臂标定值替换成错误的仿真值。当前环境里sim的docker-compose.yml
# 已经丢失（只有hw在实际使用这个Dockerfile），暂时不处理这个patch本身，
# 记在docker_sim/read_hw.md待办里。
COPY patches/dlio_pointcloud_qos.patch patches/dlio_debug_throttle.patch patches/dlio_imu_dt_clamp.patch patches/dlio_extrinsics_mount.patch patches/dlio_namespace.patch patches/dlio_gicp_fitness_debug.patch patches/dlio_bias_bounds_tighten.patch patches/dlio_keyframe_insertion_debug.patch patches/dlio_keyframe_velocity_check.patch patches/dlio_propagate_debug.patch patches/dlio_prev_imu_stamp_fix.patch patches/dlio_gravity_align_default.patch patches/dlio_spaciousness_oob_fix.patch patches/dlio_gicp_lost_track_fallback.patch patches/dlio_odom_publish_timer_cb_group.patch patches/dlio_propagate_sanity_guard.patch patches/dlio_keyframe_search_window.patch /tmp/
RUN cd /opt/dlio_ws/src/direct_lidar_inertial_odometry \
    && (git apply --check /tmp/dlio_pointcloud_qos.patch && git apply /tmp/dlio_pointcloud_qos.patch \
        || echo "!! dlio_pointcloud_qos.patch 未能自动应用，需人工核对后手动改 src/dlio/odom.cc !!") \
    && (git apply --check /tmp/dlio_debug_throttle.patch && git apply /tmp/dlio_debug_throttle.patch \
        || echo "!! dlio_debug_throttle.patch 未能自动应用，需人工核对后手动改 include/dlio/odom.h、src/dlio/odom.cc !!") \
    && (git apply --check /tmp/dlio_imu_dt_clamp.patch && git apply /tmp/dlio_imu_dt_clamp.patch \
        || echo "!! dlio_imu_dt_clamp.patch 未能自动应用，需人工核对后手动改 src/dlio/odom.cc !!") \
    && (git apply --check /tmp/dlio_extrinsics_mount.patch && git apply /tmp/dlio_extrinsics_mount.patch \
        || echo "!! dlio_extrinsics_mount.patch 未能自动应用，需人工核对后手动改 cfg/dlio.yaml !!") \
    && (git apply --check /tmp/dlio_namespace.patch && git apply /tmp/dlio_namespace.patch \
        || echo "!! dlio_namespace.patch 未能自动应用，需人工核对后手动改 launch/dlio.launch.py !!") \
    && (git apply --check /tmp/dlio_gicp_fitness_debug.patch && git apply /tmp/dlio_gicp_fitness_debug.patch \
        || echo "!! dlio_gicp_fitness_debug.patch 未能自动应用，需人工核对后手动改 src/dlio/odom.cc !!") \
    && (git apply --check /tmp/dlio_bias_bounds_tighten.patch && git apply /tmp/dlio_bias_bounds_tighten.patch \
        || echo "!! dlio_bias_bounds_tighten.patch 未能自动应用，需人工核对后手动改 cfg/params.yaml !!") \
    && (git apply --check /tmp/dlio_keyframe_insertion_debug.patch && git apply /tmp/dlio_keyframe_insertion_debug.patch \
        || echo "!! dlio_keyframe_insertion_debug.patch 未能自动应用，需人工核对后手动改 src/dlio/odom.cc !!") \
    && (git apply --check /tmp/dlio_keyframe_velocity_check.patch && git apply /tmp/dlio_keyframe_velocity_check.patch \
        || echo "!! dlio_keyframe_velocity_check.patch 未能自动应用，需人工核对后手动改 src/dlio/odom.cc、include/dlio/odom.h !!") \
    && (git apply --check /tmp/dlio_propagate_debug.patch && git apply /tmp/dlio_propagate_debug.patch \
        || echo "!! dlio_propagate_debug.patch 未能自动应用，需人工核对后手动改 src/dlio/odom.cc、include/dlio/odom.h !!") \
    && (git apply --check /tmp/dlio_prev_imu_stamp_fix.patch && git apply /tmp/dlio_prev_imu_stamp_fix.patch \
        || echo "!! dlio_prev_imu_stamp_fix.patch 未能自动应用，需人工核对后手动改 src/dlio/odom.cc !!") \
    && (git apply --check /tmp/dlio_gravity_align_default.patch && git apply /tmp/dlio_gravity_align_default.patch \
        || echo "!! dlio_gravity_align_default.patch 未能自动应用，需人工核对后手动改 cfg/params.yaml !!") \
    && (git apply --check /tmp/dlio_spaciousness_oob_fix.patch && git apply /tmp/dlio_spaciousness_oob_fix.patch \
        || echo "!! dlio_spaciousness_oob_fix.patch 未能自动应用，需人工核对后手动改 src/dlio/odom.cc !!") \
    && (git apply --check /tmp/dlio_gicp_lost_track_fallback.patch && git apply /tmp/dlio_gicp_lost_track_fallback.patch \
        || echo "!! dlio_gicp_lost_track_fallback.patch 未能自动应用，需人工核对后手动改 src/dlio/odom.cc、include/dlio/odom.h !!") \
    && (git apply --check /tmp/dlio_odom_publish_timer_cb_group.patch && git apply /tmp/dlio_odom_publish_timer_cb_group.patch \
        || echo "!! dlio_odom_publish_timer_cb_group.patch 未能自动应用，需人工核对后手动改 src/dlio/odom.cc、include/dlio/odom.h（给100Hz的odom发布定时器分配独立callback group，缓解px4ctrl报ODOM frequency过低的问题) !!") \
    && (git apply --check /tmp/dlio_propagate_sanity_guard.patch && git apply /tmp/dlio_propagate_sanity_guard.patch \
        || echo "!! dlio_propagate_sanity_guard.patch 未能自动应用，需人工核对后手动改 src/dlio/odom.cc 的propagateState()（给积分结果加dt/速度合理性检查，防止一次异常输入雪崩式发散到进程崩溃) !!") \
    && (git apply --check /tmp/dlio_keyframe_search_window.patch && git apply /tmp/dlio_keyframe_search_window.patch \
        || echo "!! dlio_keyframe_search_window.patch 未能自动应用，需人工核对后手动改 src/dlio/odom.cc、include/dlio/odom.h（buildSubmap()/computeConvexHull()/computeConcaveHull()三处原来对num_processed_keyframes做全量O(N)遍历，关键帧数量随会话时长无界增长导致CPU/内存/odom发布频率持续恶化，2026-09-04真机实测确认，加max_keyframes_for_search_参数把这三处遍历限制在最近插入的窗口内) !!")
# 用户问"NX02这个现象到底是不是IMU积分的问题，还是IMU本身有问题"——
# 顺着GICP fitness全程可疑地卡在0.0000这条线，直接读了NanoGICP/
# LsqRegistration(nano_gicp.cc、lsq_registration.cc)的优化器实现，找到了
# 目前为止最深的一层根因：不是IMU积分本身的问题，是GICP优化器对"完全没有
# 对应点"这个退化情况没有任何防护。一旦T_prior(IMU推算的初始猜测)偏得太
# 远、超出maxCorrespondenceDistance(0.5米)，target_kdtree_里所有点的最近
# 邻搜索全部失败(correspondences_全是-1)，NanoGICP::linearize()算出的
# sum_errors/H/b全部精确为0——喂进LsqRegistration::step_lm()的
# rho=(y0-yi)/(d·(lambda*d-b))变成0/0=NaN。C++里"rho<0"这个判断对NaN永远
# 是false，代码因此走进"success"分支：x0基本不变(等于原样返回了没修正的
# T_prior)、final_error_被设成精确的0.0(仪表盘上看起来像"配准完美")、
# is_converged()对着一个几乎是单位阵的delta自然也判定为true——GICP从这一
# 刻起悄悄变成纯直通IMU先验的空转状态，却一直报"收敛、误差0"，完全看不出
# 已经失效；后续updateState()拿GICP这份(其实等于什么都没修正的)输出去跟
# 同样靠IMU积分出来的state.p比，两者本来就接近一致，误差信号也跟着失真
# 变小，整个几何观测器因此也停止有效矫正，位姿彻底自由发散、只受纯IMU
# 积分本身残留的微小偏置驱动，表现为近似匀速的持续漂移(NX02实测最终稳定
# 在约1800~4100 m/s量级的"匀速"发散，直到崩溃时走了64万米)。
# 这也回答了用户的问题：propagateState/updateState/integrateImu三处核心
# 积分数学本身跟DLIO官方master分支逐字节一致(上一轮agent已核实)，不是
# IMU积分公式写错了；也不是"IMU本身数据有问题"(用的还是同一个mid360仿真
# IMU)——是GICP这一层在失去对应点之后没有诚实地报告失败，反而伪装成功，
# 导致上游依赖"GICP还在工作"这个假设的整条矫正链路失效。换飞机本体IMU
# 换不掉这个bug：不管用哪个IMU源，只要某一次积分误差恰好让先验漂出
# 0.5米对应点搜索半径，同样的NaN伪成功链路照样会触发，区别只是"多久之后
# 触发"，不是"会不会触发"。
# 修复：patches/dlio_gicp_lost_track_fallback.patch在getNextPose()里用
# this->gicp.num_correspondences(NanoGICP这次实际配对上的点数，真正配准
# 成功时是几百，退化到空转时是0或极少)识破这种伪装——低于
# gicp_min_num_points_(已有参数，配置里是64，之前一直没被用来做这个用途)
# 时，故意不更新this->T_corr/this->T，保留上一次真正配准成功时的值，让
# propagateGICP()把lidarPose钉在最后一个可信锚点上，updateState()的
# err = pin - state.p才能继续反映"当前积分状态相对最后一次可信观测究竟
# 飘了多远"这个有意义的量，而不是对着一个自己也在跟着飘的"影子目标"算出
# 虚假的小误差。这是这一整轮IMU/SLAM排查里目前为止改动最深、涉及信任
# 判断逻辑本身的一次修复，风险和潜在收益都比之前的诊断/参数类patch更大，
# 需要重点验证。
# 用户要求systematic比对DLIO的master(ROS1)和feature/ros2分支在IMU处理上的
# 差异——派了个agent直接在本地git clone上跑`git diff master feature/ros2`，
# 加上我自己手动核对issue #92对应的fix-imu-init分支，一共确认了这一轮
# 之前那个prev_imu_stamp修复之外还有两处真实差异（都已经用本地git diff
# 逐字核实过，不是agent的转述）：
# (1) cfg/params.yaml里odom/imu/approximateGravity，feature/ros2分支这套
# 配置是false，master是true——两个分支在共同祖先61a9a08("Release v1.0.0")
# 时都是false，master后来在75c875f里改成了true，但feature/ros2那时候已经
# 分叉出去了，从没跟上这个默认值变化。这个参数对应odom.cc里的
# gravity_align_标志，为true时标定阶段会根据实测重力方向重新估计初始姿态
# （state.q），为false时姿态直接保持默认值不做这一步修正——如果base_link
# 没有恰好完全水平，这个跳过的修正步骤会在从第一条IMU消息开始的重力扣除
# 计算里引入一个系统性残差。改回true，跟master的（更新过的）默认值对齐。
# (2) src/dlio/odom.cc的computeSpaciousness()里有个越界读：
# `for (int i = 0; i <= this->original_scan->points.size(); i++)`多读了
# points[size()]一个不存在的元素（未定义行为）。master在c389288
# ("Fix segmentation fault caused by out-of-bounds array access")里已经
# 改回`<`，但feature/ros2分支比master落后23个commit、从来没同步到这个
# 修复。这个函数算出来的spaciousness直接喂给setAdaptiveParams()，正是
# 之前发现"关键帧插入阈值被自适应放大到默认值5倍"这个机制的输入——越界
# 读到的垃圾值有可能是那次异常放大的一部分原因。
# agent还额外核实到一处"master和feature/ros2都有、不是ROS2移植独有"的
# 已知upstream bug（Livox IMU未按g单位换算，feature/livox-support分支有
# 未合并的修复）——这套仿真里mid360 IMU插件直接输出SI单位m/s²（之前实测
# 静止时线加速度模长约9.8，不是约1.0），不受这个问题影响，本轮未处理，
# 留给以后接真实Livox硬件时再核对。
# propagateState/updateState/integrateImu三处核心积分数学逻辑，agent确认
# 跟master逐字节一致，没有额外差异。
# 上一轮关键帧修复验证后，用户要求查IMU积分本身是否有问题，并让查DLIO是不是
# 官方clone、查官方issue列表——都是对的：staging/dlio_ws_src/direct_lidar_
# inertial_odometry确实是从https://github.com/vectr-ucla/direct_lidar_
# inertial_odometry.git官方clone的，用的是feature/ros2这个社区贡献的ROS2
# 移植分支，不是原作者一直维护、用户口中"ROS1版本很好用"的master分支——查了
# 一下，feature/ros2分支比master落后23个commit，有一个还没合并的PR #100
# 明确写着想把master后续的bug修复同步过来。
# 顺着"ROS2移植可能有独有bug"这条线查到了两个跟本项目症状高度吻合的官方
# issue：#78("ros2 IMU calibration"，Ouster，Z轴accel bias锁死在-5导致
# 严重漂移，作者原话"there is no calibration step when compared to the
# main branch")、#71（Livox Mid-360，同样accel bias锁死在-5附近）——两个
# 都是"静止/低速状态下Z轴/整体发散、accel bias顶到硬边界"，跟这个项目
# 从最开始"走了两千多米"到现在"六万八千米"这整条主线症状完全对得上。修这两个
# issue的PR #79只改了cfg/dlio.yaml的外参数值（跟本项目自己的
# dlio_extrinsics_mount.patch做的事类似——这个patch原名dlio_extrinsics_
# tilt.patch，mid360从30度前倾改成水平安装之后改名并重写了内容，历史沿革
# 见README.md），完全没碰源码——issue本身描述的
# "缺少标定步骤"这层代码逻辑问题从来没被真正修过。
# 顺着这条线又挖到了issue #92("Set prev_imu_stamp on IMU calibration")，
# 直接对上src/dlio/odom.cc里能独立复现验证的一个真实bug：this->prev_imu_
# stamp在构造函数里初始化成0.，标定阶段（imu_calibrated还是false的那个
# if分支）整个过程从来没碰过它——calibrate_accel_/calibrate_gyro_只在标定
# 结束那一刻跑一次，标定期间的每条IMU消息走的是外层"没标定"分支，压根不会
# 执行到下面"已标定"分支里"double dt = imu_stamp_secs - this->prev_imu_
# stamp;"这行。等标定真正结束、第一条"已标定"消息进来才第一次执行到这行，
# prev_imu_stamp依然是那个从没被更新过的0.，imu_stamp_secs此时已经是
# 十亿量级的epoch绝对时间戳（这套仿真里是mighty_imu_sim_time.patch/
# livox_imu_lidar_sim_time.patch那个固定偏移1735689600+几秒，真机上是墙钟
# epoch，同样是十亿级），算出来的dt是一个天文数字，直接喂进
# propagateState()的`0.5*dt*dt*(...)`这一项，一步就能把position/velocity
# 冲到无穷大或者巨大数值——这解释了为什么"accel bias秒杀式顶到abias_max
# 上限"贯穿了这整个项目从第一次发现发散问题到现在的每一轮排查，也解释了
# 为什么此前那么多轮修复（点云假点、IMU dt钳位、IMU零噪声、sim time时间戳）
# 都没解决核心问题——它们都没碰到这个只在"标定刚结束那一刻"触发一次的
# 天文数字级dt。也解释了为什么之前测的"墙钟"和"仿真时钟"两种方案都同样
# 发散：不管哪种，两者都是epoch量级的绝对值，减去0都是天文数字，这个bug
# 对两种clock策略都成立，是本项目这条时间戳调查线里唯一没被排除、且已经
# 被DLIO官方仓库issue独立记录过的候选根因。
# 两个patch：dlio_propagate_debug.patch是纯诊断（propagateState()里打印
# 纯IMU死推算——不经GICP/geometric observer矫正——算出来的world_accel/净
# 加速度/速度/位置，直接在callbackImu()所在的单一线程内、geo.mtx这把已有
# 锁保护范围内打印，不新增线程安全风险）；dlio_prev_imu_stamp_fix.patch是
# 真正的修复：标定完成的那一刻把prev_imu_stamp显式设成当前时间戳，让"已
# 标定"分支第一次算dt时用的是正确的采样间隔，不是从0开始算的天文数字。
# 效果待重新build验证。
# 上面dlio_keyframe_insertion_debug.patch的诊断实测确认了：飞机全程静止，
# 一架能插出几百个关键帧，估计位置飘出上百米——updateKeyframes()的插入
# 判据只看this->state.p(估计位置)，从没跟"是否真的物理移动过"做过交叉
# 核实，一旦估计值开始飘，每次飘过阈值就照样插入新关键帧，把错误位姿焊进
# 地图，后续扫描对着被污染的地图继续"配准得很好"（GICP fitness全程接近0，
# 因为对的是自己刚参与污染出来的地图，不是客观真值），是一条自我强化的
# 发散循环。这个patch加一层物理合理性检查：新关键帧触发时，用这次的位移
# dd除以距最近关键帧的时间差算出"隐含速度"，超过keyframe_max_velocity_
# （新增参数odom/keyframe/maxVelocity，默认5m/s——这套仿真是20米见方小
# 房间里的四旋翼，正常飞行不可能达到，参考此前日志里"dd=6.99m"级别的跳变
# 几乎肯定不是真实物理运动）就拒绝这次插入，只打印警告，地图保持在最后
# 一个"合理"的关键帧状态、不再继续被污染。不是"确认解决发散"的根因修复
# （估计值本身为什么会开始飘还没查清楚），是一个直接针对已确认机制
# （关键帧插入对估计值盲目信任）的定向circuit breaker，效果待重新build
# 验证——具体要看：地图不再被污染之后，GICP会不会真的把估计值拉回来，
# 还是estimate继续自己飘、只是不再连累地图。
# 加了GICP fitness诊断之后（见上面dlio_gicp_fitness_debug.patch）实测发现：
# 静止的飞机"走了几米到十几米"再崩溃之前，仪表盘里GICP那一行几乎全程显示
# "converged: yes, fitness: 0.0000"——配准本身报告的是完美收敛，跟"轨迹在
# 跑飞"这个表象完全对不上，基本排除了"点云配准精度差/房间几何退化导致GICP
# 配准病态"这个假说。直接看updateKeyframes()的关键帧插入判据：newKeyframe
# 完全基于this->state.p（估计出来的位置）去跟已有关键帧比距离/角度，没有
# 任何跟"飞机是否真的物理移动过"的交叉核实——如果估计值本身已经在飘，飘过
# keyframe_thresh_dist_(1.0米)照样会插入新关键帧，把当前(其实是错的)位姿和
# 点云焊进地图。后续扫描很可能对着这个已经被污染的地图配准得"很好"（因为
# 都是同一条漂移轨迹自洽推出来的），这能完整解释"GICP显示完美收敛，但整条
# 轨迹早就飘出去了"这个现象。这个patch在关键帧真正插入的那一刻打印触发它的
# dd（距最近关键帧的距离）和当前估计位置，直接在callbackPointCloud所在的
# 主线程里同步打印（不经过debug()那个detached线程，不碰GICP/PCL任何内部
# 状态，只读updateKeyframes()内部本来就已经算好的普通局部变量），没有线程
# 安全或空指针风险——前面三轮GICP fitness诊断折腾出的教训（PCL基类方法对
# NanoGICP这个子类不安全、跨线程调用GICP对象有数据竞争）这次都避开了。
# 用户问"mighty原本的仿真程序里根本没跑DLIO吧"——查证属实：mighty自己的
# run_sim.py/onboard_mighty.launch.py里，use_hardware=false（原生仿真分支）
# 那段代码明确标注"=== EXISTING SIM CODE — COMPLETELY UNCHANGED ==="，用的是
# fake_sim_node（不经过Gazebo物理、直接对规划轨迹积分），DLIO只出现在
# use_hardware=true这个硬件分支里（"HW: Odom to state (DLIO remapping)"）——
# 这套docker_sim为了端到端验证真实机载软件栈，故意让mighty在Gazebo里走
# use_hardware=true分支，这是mighty/DLIO原作者都没测过的组合。
# 顺着这个思路查DLIO自己的cfg/dlio.yaml、cfg/params.yaml：git log显示这两个
# 文件从来没被这个项目自己的开发者改过（历史只有DLIO上游自己的commit，加
# ROS2支持、加Hesai支持这些），GICP/关键帧/体素分辨率、accel/gyro bias上限
# 全是DLIO官方示例（大尺度Ouster室外/校园场景）的原始默认值，从没针对这套
# 20x20米小房间+Mid-360（20米量程、单帧仅1000点）重新调过。
# 两处改动：(1) dlio_gicp_fitness_debug.patch纯诊断，在仪表盘里加一行GICP
# 收敛状态+fitness score（PCL Registration标准API，NanoGICP经LsqRegistration
# 继承自pcl::Registration），之前这两个量只在代码里算了从没打印过，想直接
# 看清"配准本身是不是在正常收敛"就得先有这个数据，零风险、不改变任何行为。
# (2) dlio_bias_bounds_tighten.patch把abias_max从5.0（m/s²）收紧到0.3、
# gbias_max从0.5（rad/s）收紧到0.05——5.0 m/s²对任何真实MEMS IMU来说都是
# 荒谬的量级（真实bias一般在0.01~0.3量级），这么松的上限等于给了在线bias估计
# 一个几乎没有约束的容器，配准误差可以被它悄悄吸收、越攒越大直到真的顶到
# 5.0才现形（"原地飘几千米"）。收紧上限本身不解决配准误差从哪来，但能让
# 这类误差在到达灾难性量级之前就先被"卡住"、暴露出来，是一个诊断性质更强
# 的改动，不是确认有效的根因修复。改的是odom/geo/abias_max/gbias_max这两个
# 运行时钳位（geometric observer每次更新后的钳位），不影响启动时的一次性
# IMU标定（那段代码不读这两个参数）。
# 上游 dlio.launch.py 里的 Node() 从来没有设置 namespace= ——entrypoint 传的
# namespace:=NX01/NX02 这个launch参数其实是`ros2 launch`静默忽略的死参数（launch
# 文件根本没声明它），实际生效的只有pointcloud_topic/imu_topic两个显式remap，output
# 话题(odom/pose/keyframes/...)和节点名本身都还是裸的全局名字 `dlio_odom_node`、
# `dlio/odom_node/odom` 等。sim-world/flight-stack-nx01/nx02三个容器全是
# network_mode: host + ipc: host，共享同一个ROS graph——NX01和NX02两边的DLIO因此
# 节点名/话题/服务全部撞在一起：`ros2 node list`能看到"share an exact name"的警告，
# 两边的keyframe点云互相串话，实测NX02那边最终直接因为fastcdr反序列化到不匹配的
# buffer而`terminate called after throwing 'NotEnoughMemoryException'`崩溃退出，
# NX01这边则是里程计内部状态被另一台飞机的数据污染后原地飘到几千米开外（accel bias
# 也被顶到硬编码的±5.0上限）——这才是"两架飞机里程计都飘得很厉害"的真正根因，跟前面
# 那个30度外参修正没关系（外参修正本身是对的，问题出在这一层）。这个patch给
# dlio.launch.py补上真正生效的namespace参数（Node(namespace=...)），顺带把
# frames/odom、frames/baselink等TF frame_id也按namespace加前缀（跟mighty自己
# `${namespace}/base_link`等约定对齐，见 onboard_mighty.launch.py），否则/tf上
# 还是会用裸的"odom"/"base_link"两边打架。配套修复见下面 entrypoint 里
# pointcloud_topic/imu_topic 传参方式的调整——现在namespace由Node自己加，
# entrypoint不能再重复拼一遍前缀。
# dlio.yaml 里 baselink2imu/baselink2lidar 的外参R原来是单位矩阵，t也是抄的某个
# 真实硬件标定值——没考虑 mid360.xacro 里雷达30度前倾的安装角度（对应
# quadrotor.urdf.xacro 里 joint origin rpy="0 0.5236 0"），DLIO会把倾斜坐标系
# 下的传感器读数当成base_link是水平的来处理，重力对齐从第一步就是错的，
# 里程计会systematic地飘，不是噪声累积那种慢慢飘。上面这个patch按同一个30度
# 重新算了R（IMU传感器跟lidar挂在同一个link上，两者外参完全一致）。
# Dockerfile.base 最后一层 rm -rf 掉了 /var/lib/apt/lists，这里的 apt-get update
# 补回索引——不然 rosdep install 内部调用的 apt-get install 会报 "Unable to
# locate package"（索引是空的，不是包真不存在），静默失败后colcon build时才在
# find_package这一步炸出来，很难联想到根因。
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/ccache,id=ai-uav-ccache \
    apt-get update \
    && source /opt/ros/humble/setup.bash \
    && cd /opt/dlio_ws \
    && rosdep update \
    && rosdep install --from-paths src --ignore-src -r -y || true \
    && colcon build --parallel-workers "${BUILD_JOBS}" --cmake-args -DCMAKE_BUILD_TYPE=Release

# ============================================================
# 2. mighty（规划器本体 + 其全部依赖，同 sim-world 镜像一致的源码）
#    注意：这里只需要规划算法本身，不需要 -DBUILD_SIMULATION=ON（不含Gazebo相关
#    target），减小这个镜像的体积，也避免机载侧误依赖Gazebo。
# ============================================================
COPY staging/decomp_ws_src /opt/decomp_ws/src
# decomp_rviz_plugins 的 package.xml 没有把 decomp_util 声明成依赖，colcon 不会
# 自动把 decomp_util 的安装路径注入 CMAKE_PREFIX_PATH——光按顺序build不够，
# 中间必须手动 source 一次 decomp_util 的 install/setup.bash 才能让后续
# find_package(decomp_util) 找到 decomp_utilConfig.cmake。
RUN --mount=type=cache,target=/ccache,id=ai-uav-ccache \
    source /opt/ros/humble/setup.bash \
    && cd /opt/decomp_ws \
    && colcon build --parallel-workers "${BUILD_JOBS}" --packages-select decomp_util --cmake-args -DCMAKE_BUILD_TYPE=Release \
    && source /opt/decomp_ws/install/setup.bash \
    && colcon build --parallel-workers "${BUILD_JOBS}" --cmake-args -DCMAKE_BUILD_TYPE=Release

COPY staging/mighty_ws_src /opt/mighty_ws/src

# 2026-09-17新增/2026-09-18删除：logical_camera插件补丁——排查了一整天
# 确认插件在gzserver进程内publish()之后消息完全送不到任何订阅者，根因
# 未定位到，用户决定放弃这条路，patch文件、`logical_camera_bridge_node.py`、
# `gen_iris_mid360_sdf.py`里的相关代码全部删除，见DEBUG_JOURNAL.md
# 2026-09-17/09-18记录。

COPY patches/mighty_lidar_frame_id.patch patches/mighty_occupancy_grid_qos_fix.patch patches/mighty_sensor_mount.patch patches/mighty_onboard_vehicle_profile.patch patches/mighty_lidar_point_cloud_topic_arg.patch patches/mighty_static_tf_fix.patch patches/mighty_static_tf_namespace_fix.patch patches/mighty_disable_d435.patch patches/mighty_enable_gravity.patch patches/mighty_force_goal_z.patch patches/mighty_headless_yaw_fix.patch patches/mighty_local_frame_only.patch patches/mighty_avoidance_tuning.patch patches/mighty_replan_failure_cap.patch patches/mighty_share_traj_heartbeat.patch patches/mighty_replan_state_resync.patch patches/mighty_findandatime_live_state_fallback.patch patches/mighty_swarm_goal_deconfliction.patch patches/mighty_freestart_escalation.patch patches/mighty_trajectory_wall_check_log.patch patches/mighty_z_window_ceiling_occupied.patch patches/mighty_z_range_narrow.patch patches/mighty_traveling_yaw_zero_dist_guard.patch patches/mighty_enable_thrust_constraint.patch patches/mighty_avoidance_horizon_guard.patch patches/mighty_goal_overshoot_tuning.patch patches/mighty_planning_params_override_note.patch patches/mighty_yaw_lookahead.patch patches/mighty_yaw_proportional_rate.patch patches/mighty_yaw_filter_alpha_fix.patch patches/mighty_yaw_lookahead_5s_goal_aim.patch patches/mighty_goal_seen_yaw_freeze.patch patches/mighty_yaw_debug_print.patch patches/mighty_conditional_gazebo_ros_deps.patch /tmp/
