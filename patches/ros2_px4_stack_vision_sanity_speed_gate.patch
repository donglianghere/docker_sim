     def _livox_odom_cb(self, msg):
+        # 合理性检查放在最前面：不合理就直接return，不做下面任何构造/
+        # 发布/_last_recv_time更新——这样如果上游持续发跳变坏值，
+        # _last_recv_time会停留在最后一次好数据的时刻，stale_timeout_sec
+        # 看门狗能正确判定"已经陈旧"并报警，而不是被这些坏值持续"续命"。
+        p = msg.pose.pose.position
+        cur_pos = (p.x, p.y, p.z)
+        cur_stamp = Time.from_msg(msg.header.stamp)
+        if self._last_fwd_pos is not None and self._last_fwd_stamp is not None:
+            dt = (cur_stamp - self._last_fwd_stamp).nanoseconds / 1e9
+            if dt > 1e-3:  # dt太小(含0/负值，比如乱序消息)算出的速度没意义，跳过本次检查
+                dist = ((cur_pos[0] - self._last_fwd_pos[0]) ** 2 +
+                        (cur_pos[1] - self._last_fwd_pos[1]) ** 2 +
+                        (cur_pos[2] - self._last_fwd_pos[2]) ** 2) ** 0.5
+                implied_speed = dist / dt
+                if implied_speed > self.max_reasonable_speed_mps:
+                    self.get_logger().error(
+                        f"丢弃这一帧odom：隐含速度{implied_speed:.1f}m/s "
+                        f"(位移{dist:.2f}m / dt={dt:.3f}s) 超过合理阈值"
+                        f"{self.max_reasonable_speed_mps}m/s，大概率是上游"
+                        f"定位源重连时的不连续跳变，不转发给PX4，继续保留"
+                        f"上一帧")
+                    return
+        self._last_fwd_pos = cur_pos
+        self._last_fwd_stamp = cur_stamp
+
