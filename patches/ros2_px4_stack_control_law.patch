@@ -83,6 +83,31 @@ class OffboardDynusFollower(BasicMavrosInterface):
         self.attitude_setpoint = None
         self.received_trajectory_setpoint = None
 
+        # Which control law to use once past TAKEOFF (see takeoff_and_track_trajectory's
+        # TRAJECTORY branch below):
+        #   'trajectory' (default) -- _pack_into_traj(): position/velocity/acceleration +
+        #       attitude/body-rate all packed into MultiDOFJointTrajectory, published to
+        #       mavros/setpoint_trajectory/local. PX4's own position controller does the
+        #       actual closed-loop tracking; mavros's setpoint_trajectory plugin only
+        #       forwards position/velocity/acceleration/yaw/yaw_rate to PX4 (confirmed by
+        #       reading setpoint_trajectory.cpp) -- the full attitude quaternion and body
+        #       rates this mode computes never actually reach PX4, only their yaw component
+        #       does. This is the only mode that has ever actually been exercised/flown in
+        #       this project.
+        #   'attitude' -- _pack_into_attitude(): pure differential-flatness, publishes
+        #       orientation quaternion + body rates + normalized thrust directly to
+        #       mavros/setpoint_raw/attitude, bypassing PX4's position/velocity loops
+        #       entirely (PX4 only runs its innermost attitude/rate controller). The
+        #       get_orientation()/get_angular()/get_thrust() math has been checked and is
+        #       correct, and self.attitude_pub has always existed and been wired to the
+        #       right topic -- this mode was fully built but never actually connected to
+        #       anything until this parameter was added, so treat it as UNFLOWN: the math
+        #       being correct on paper is not the same as having been validated in flight.
+        self.declare_parameter('control_law', 'trajectory')
+        self.control_law = self.get_parameter('control_law').value
+        assert self.control_law in ('trajectory', 'attitude'), \
+            f"Invalid control_law: {self.control_law} (must be 'trajectory' or 'attitude')"
+
         # Dynus subscriptions/publishers
         veh = os.environ.get("VEH_NAME")
         self.dynus_goal_topic = f'/{veh}/goal'
