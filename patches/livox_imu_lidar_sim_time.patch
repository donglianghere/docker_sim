+// See the matching helper/comment in mighty's src/sim/gazebo_ros_imu_sensor.cpp for the
+// full rationale. Short version: real-time-factor drifts sustained below 1.0 under this
+// host's dual-drone load (measured ~0.96-0.97 live via `gz stats`), so a wall-clock-
+// stamped IMU/point-cloud dt is systematically larger than the sim time actually elapsed
+// -- almost certainly the dominant cause of this project's long-standing "DLIO diverges
+// to thousands of meters while stationary" bug. Gazebo sim time is immune to that drift
+// by definition, but a raw sim-time value (~seconds since sim start) is too small to
+// clear DLIO's own >1e14ns Livox-vs-Hesai autodetect threshold in getScanFromROS() (see
+// the comment this replaces, from livox_pointcloud_timestamp.patch) and gets
+// misclassified, silently freezing deskewing. Offsetting sim time by a fixed large
+// constant keeps it looking like a plausible absolute epoch for that heuristic while
+// every *delta* between consecutive stamps stays exactly equal to true elapsed sim time.
+// The IMU plugin uses the identical constant so both streams share one consistent clock,
+// which deskewing's IMU-buffer bracket search (integrateImu()) requires.
+constexpr int64_t kFakeEpochOffsetNs = 1735689600LL * 1000000000LL;  // 2025-01-01T00:00:00Z
+
+builtin_interfaces::msg::Time SimTimeAsFakeEpoch(const gazebo::common::Time & sim_time)
+{
+  int64_t sim_ns = static_cast<int64_t>(sim_time.sec) * 1000000000LL +
+    static_cast<int64_t>(sim_time.nsec) + kFakeEpochOffsetNs;
+  builtin_interfaces::msg::Time t;
+  t.sec = static_cast<int32_t>(sim_ns / 1000000000LL);
+  t.nanosec = static_cast<uint32_t>(sim_ns % 1000000000LL);
+  return t;
+}
+}  // namespace
+
