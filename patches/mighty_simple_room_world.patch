+    <model name='room_wall_south'>
+      <static>1</static>
+      <link name='link'>
+        <collision name='collision'>
+          <geometry><box><size>20.3 0.3 5</size></box></geometry>
+        </collision>
+        <visual name='visual'>
+          <geometry><box><size>20.3 0.3 5</size></box></geometry>
+          <material>
