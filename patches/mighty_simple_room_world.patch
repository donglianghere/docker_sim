+              <name>Gazebo/White</name>
+            </script>
+          </material>
+        </visual>
+      </link>
+      <pose>0 -10 2.5 0 0 0</pose>
+    </model>
+    <model name='room_wall_east'>
+      <static>1</static>
+      <link name='link'>
+        <collision name='collision'>
+          <geometry><box><size>0.3 20.3 5</size></box></geometry>
+        </collision>
+        <visual name='visual'>
+          <geometry><box><size>0.3 20.3 5</size></box></geometry>
+          <material>
+            <script>
+              <uri>file://media/materials/scripts/gazebo.material</uri>
+              <name>Gazebo/White</name>
+            </script>
+          </material>
+        </visual>
+      </link>
+      <pose>10 0 2.5 0 0 0</pose>
+    </model>
+    <model name='room_wall_west'>
+      <static>1</static>
+      <link name='link'>
+        <collision name='collision'>
+          <geometry><box><size>0.3 20.3 5</size></box></geometry>
+        </collision>
+        <visual name='visual'>
+          <geometry><box><size>0.3 20.3 5</size></box></geometry>
+          <material>
+            <script>
+              <uri>file://media/materials/scripts/gazebo.material</uri>
+              <name>Gazebo/White</name>
+            </script>
+          </material>
+        </visual>
+      </link>
+      <pose>-10 0 2.5 0 0 0</pose>
+    </model>
+
+    <!-- 5根直径0.5米(半径0.25米)、高5米的柱子，交错随机分布在房间中部当障碍物用
+         （第一版摆在(-5,-5)/(-5,5)/(0,-7)/(9,6)，为了躲开两机spawn点(3,0,3)/
