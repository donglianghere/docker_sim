+
+    <!-- 天花板：房间原来只有地面+四面墙、没有顶——mid360前倾30度安装之后，
+         视场里仍有相当一部分朝上，这部分射线在开放空间里永远打不到任何东西，
+         Gazebo的射线插件对"没打中"的情况会填一个卡在最大量程(20米)的假点，不是
+         真实障碍物几何。实测确认过：一帧1000个原始点里，30%落在19.9~20米这个
+         "打空了"的区间，且这些假点角度相邻、距离几乎完全相同，做5cm体素降采样时
+         会大量重叠合并，配准阶段被GICP当成真实结构处理，很可能是DLIO在飞机静止
+         状态下依然算出"走了1762米"这种灾难性发散的原因之一。补一个跟地面对称的
+         天花板（法线朝下，位于z=5，即墙高处），让朝上的射线也有真实几何可打，
+         消除这部分"最大量程噪声"。 -->
+    <model name='ceiling'>
+      <static>1</static>
+      <pose>0 0 5 0 0 0</pose>
+      <link name='link'>
+        <!-- 碰撞体用有限厚度的box（0.1米），不用跟地面一样的<plane>——<plane>
+             是无限延伸的半空间几何体，这个房间里地面已经有一个朝上的<plane>了，
+             天花板如果也用<plane>（朝下），就是两个无限半空间正对着，ODE
+             物理引擎在这种组合下接触解算容易不稳定：实测确认过——两架飞机
+             都出现了"贴地摆放的飞机沉到地面以下2.6米、机身还严重侧翻约73度"
+             这种炸裂状态，日志里却什么错误都没打出来。四面墙一直用的就是
+             box、从来没出过这个问题，天花板改成同样的box行事，避免引入
+             这套world里第一次出现的"两个无限平面对撞"组合。 -->
+        <collision name='collision'>
+          <geometry>
+            <box><size>20.3 20.3 0.1</size></box>
+          </geometry>
+          <surface>
+            <contact>
+              <collide_without_contact>0</collide_without_contact>
+              <ode>
+                <kp>1000000.0</kp>
+                <kd>100.0</kd>
+                <max_vel>1.0</max_vel>
+                <min_depth>0.001</min_depth>
+              </ode>
+            </contact>
+            <friction>
+              <ode>
+                <mu>100</mu>
+                <mu2>50</mu2>
+              </ode>
+              <torsional>
+                <ode/>
+              </torsional>
+            </friction>
+            <bounce/>
+          </surface>
+          <max_contacts>10</max_contacts>
+        </collision>
+        <visual name='visual'>
+          <cast_shadows>0</cast_shadows>
+          <geometry>
+            <box><size>20.3 20.3 0.1</size></box>
+          </geometry>
+          <material>
+            <script>
+              <uri>file://media/materials/scripts/gazebo.material</uri>
+              <name>Gazebo/Grey</name>
+            </script>
+          </material>
+          <!-- 只让视觉外观透明，不影响上面的<collision>——Gazebo里射线传感器
+               打的是collision几何体，跟visual外观是两回事，transparency只改
+               GUI里看到的样子，激光该反射还是照样反射。设成0.9（几乎全透明，
+               GUI里能透过天花板看到房间内部/飞机，但天花板本身还留一点点
+               轮廓，不是完全隐形，方便确认它确实还在那）。 -->
+          <transparency>0.9</transparency>
+        </visual>
+        <self_collide>0</self_collide>
+        <enable_wind>0</enable_wind>
+        <kinematic>0</kinematic>
+      </link>
+    </model>
+
+    <!-- 四面墙，围成20x20x5米的封闭房间，墙厚0.3米，房间中心在原点，
+         飞机spawn点(3,0,3)/(6,0,3)都在房间内、离墙有富余净空 -->
+    <model name='room_wall_north'>
+      <static>1</static>
+      <link name='link'>
+        <collision name='collision'>
+          <geometry><box><size>20.3 0.3 5</size></box></geometry>
+        </collision>
+        <visual name='visual'>
+          <geometry><box><size>20.3 0.3 5</size></box></geometry>
+          <material>
+            <script>
+              <uri>file://media/materials/scripts/gazebo.material</uri>
