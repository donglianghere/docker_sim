     pcl::toROSMsg(cloud, *pointcloud);
     pointcloud->header.frame_id = params_.global_frame;
-    pointcloud->header.stamp = rclcpp::Clock().now();
+    // 这条以及本文件里其余6处output message的header.stamp，原来都是
+    // this->now()/rclcpp::Clock().now()（这个node的真实墙钟）。喂进这个
+    // mapper的点云/位姿全部来自DLIO，走的是仿真侧一个固定偏移过的"假epoch"
+    // 时钟（sim时间+1735689600，见mighty_imu_sim_time.patch的注释），两个
+    // clock域实测能差出接近5000万秒。RViz渲染occupancy_grid/unknown_grid
+    // 这类消息时，只要Fixed Frame跟消息本身的frame_id不是同一个namespace
+    // （比如Fixed Frame=NX01/map时看NX02/occupancy_grid），就必须在消息
+    // 自带的header.stamp那一刻查一次跨namespace的TF——查UWB桥接TF
+    // （NX01/map -> NX02/map，现在盖的是DLIO时钟域，见
+    // uwb_ground_truth_node.py的同类修复）时，如果这条消息自己盖的是墙钟
+    // 时间，两边就找不到公共有效时间窗，直接查不到，RViz里表现就是"同
+    // namespace能看到、跨namespace的另一架飞机看不到"。改用
+    // tstampLastPclFused_（PointCloudCallback里存的、来自DLIO点云本身
+    // header.stamp的时间戳），让这些输出消息回到跟点云/位姿一致的
+    // clock域，才能被tf2正常解算。
+    pointcloud->header.stamp = tstampLastPclFused_;
   }
 
