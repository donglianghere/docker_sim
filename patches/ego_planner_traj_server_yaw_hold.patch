+// 原地转向的一个周期：返回true表示这一周期已经发了指令（调用方直接返回）
+bool publishYawHold()
+{
+  rclcpp::Clock clock(RCL_ROS_TIME);
+  rclcpp::Time now = clock.now();
+  if (!have_odom_ || (now - odom_stamp_).seconds() > ODOM_STALE_SEC)
+  {
+    yaw_hold_active_ = false;     // 里程计不新鲜，不发位置指令
+    return false;
+  }
+  if ((now - yaw_hold_start_).seconds() > YAW_HOLD_MAX_SEC)
+  {
+    yaw_hold_active_ = false;
+    return false;
+  }
+
+  double yaw_target;
+  if (yaw_mode_ == YAW_MODE_POINT)
+    yaw_target = atan2(yaw_target_y_ - yaw_hold_pos_(1), yaw_target_x_ - yaw_hold_pos_(0));
+  else if (yaw_mode_ == YAW_MODE_CONSTANT)
+    yaw_target = yaw_constant_;
+  else
+  {
+    yaw_hold_active_ = false;     // VELOCITY模式原地没有速度方向可言
+    return false;
+  }
+
+  static rclcpp::Time yaw_hold_last = now;
+  double dt = (now - yaw_hold_last).seconds();
+  yaw_hold_last = now;
+  dt = std::max(0.0, std::min(dt, 0.1));
+
+  double err = yaw_target - last_yaw_;
+  while (err > M_PI) err -= 2 * M_PI;
+  while (err < -M_PI) err += 2 * M_PI;
+
+  if (fabs(err) <= YAW_HOLD_TOL_RAD)
+  {
+    if (!yaw_hold_reached_valid_)
+    {
+      yaw_hold_reached_ = now;
+      yaw_hold_reached_valid_ = true;
+    }
+    else if ((now - yaw_hold_reached_).seconds() > YAW_HOLD_SETTLE_SEC)
+    {
+      // 转到位并稳住了：停发，交还pt4ctrl的AUTO_HOVER（它会把新朝向记进
+      // hover_pose，所以松手之后不会转回去）
+      yaw_hold_active_ = false;
+      return false;
+    }
+  }
+  else
+  {
+    yaw_hold_reached_valid_ = false;
+  }
+
+  double step = yaw_dot_max_ * dt;               // 按跟飞行时同一个限速转
+  double yaw = last_yaw_ + std::max(-step, std::min(err, step));
+  while (yaw > M_PI) yaw -= 2 * M_PI;
+  while (yaw < -M_PI) yaw += 2 * M_PI;
+
+  cmd.header.stamp = now;
+  cmd.header.frame_id = "world";
+  cmd.trajectory_flag = quadrotor_msgs::msg::PositionCommand::TRAJECTORY_STATUS_READY;
+  cmd.trajectory_id = traj_id_;
+  cmd.position.x = yaw_hold_pos_(0);
+  cmd.position.y = yaw_hold_pos_(1);
+  cmd.position.z = yaw_hold_pos_(2);
+  cmd.velocity.x = cmd.velocity.y = cmd.velocity.z = 0.0;
+  cmd.acceleration.x = cmd.acceleration.y = cmd.acceleration.z = 0.0;
+  cmd.jerk.x = cmd.jerk.y = cmd.jerk.z = 0.0;
+  cmd.yaw = yaw;
+  cmd.yaw_dot = (fabs(err) <= YAW_HOLD_TOL_RAD) ? 0.0 : (err > 0 ? yaw_dot_max_ : -yaw_dot_max_);
+  last_yaw_ = yaw;
+  pos_cmd_pub->publish(cmd);
+  return true;
+}
