+// docker_sim 2026-09-23：原地转向（悬停时改朝向）。
+//
+// 背景：飞机停下来之后没有任何地方在发position_cmd——本文件到达终点后只再
+// 发HOVER_AFTER_FINISH_SEC就主动停发（见cmdCallback里的说明），pt4ctrl于是
+// 退回AUTO_HOVER，而AUTO_HOVER的des.yaw取的是**进入悬停那一刻**的yaw
+// （PX4CtrlFSM.cpp::set_hover_with_odom()），之后不再更新。结果就是"悬停时
+// 调set_yaw_mode_point()没有任何反应"：实测悬停着连发4次yaw微调，画面里目标
+// 的偏差从-21.9°只动到-21.2°。高层火情要"悬停并对准着火点"，绕不过这一条。
+//
+// 做法：空闲（没有轨迹在跑）时收到新的yaw模式/参数，就以**收到那一刻的位置**
+// 为固定目标位置持续发position_cmd，只让yaw按限速转向目标角度；转到位（或超时）
+// 后停发，交还给pt4ctrl的AUTO_HOVER——它重新进入悬停时会把新的朝向记进
+// hover_pose，所以转完就稳在新朝向上。
+//
+// 几条刻意的约束：
+// - 位置目标是**转向开始那一刻锁存**的，不是每周期取当前里程计（后者会随噪声
+//   漂移，等于让飞机跟着自己的测量误差走）。
+// - 里程计太旧（超过ODOM_STALE_SEC）不发指令：宁可不转，也不能拿着过期位置
+//   去发位置指令。
+// - 有轨迹在跑时这套逻辑完全不介入，正常飞行的行为一字不变。
+constexpr double YAW_HOLD_MAX_SEC = 8.0;      // 最多转这么久，超时就放弃
+constexpr double YAW_HOLD_TOL_RAD = 0.035;    // 约2°，到这个精度就算转到位
+constexpr double YAW_HOLD_SETTLE_SEC = 0.5;   // 到位后再发一会，让控制器收敛
+constexpr double ODOM_STALE_SEC = 0.5;
+
+bool yaw_hold_active_ = false;
+rclcpp::Time yaw_hold_start_;
+rclcpp::Time yaw_hold_reached_;
+bool yaw_hold_reached_valid_ = false;
+Eigen::Vector3d yaw_hold_pos_(0, 0, 0);
+
+Eigen::Vector3d odom_pos_(0, 0, 0);
+double odom_yaw_ = 0.0;
+bool have_odom_ = false;
+rclcpp::Time odom_stamp_;
+
+void odomCallback(nav_msgs::msg::Odometry::ConstSharedPtr msg)
+{
+  odom_pos_ << msg->pose.pose.position.x, msg->pose.pose.position.y, msg->pose.pose.position.z;
+  const auto &q = msg->pose.pose.orientation;
+  odom_yaw_ = atan2(2.0 * (q.w * q.z + q.x * q.y), 1.0 - 2.0 * (q.y * q.y + q.z * q.z));
+  odom_stamp_ = rclcpp::Clock(RCL_ROS_TIME).now();
+  have_odom_ = true;
+}
+
+// 收到新的朝向指令：没有轨迹在跑就启动一次原地转向
+void startYawHoldIfIdle()
+{
+  if (receive_traj_ || !have_odom_)
+    return;
+  rclcpp::Clock clock(RCL_ROS_TIME);
+  yaw_hold_active_ = true;
+  yaw_hold_reached_valid_ = false;
+  yaw_hold_start_ = clock.now();
+  yaw_hold_pos_ = odom_pos_;      // 锁存位置，见上面说明
+  last_yaw_ = odom_yaw_;          // 从实际朝向接着转，避免跳变
+  last_yaw_dot_ = 0.0;
+}
