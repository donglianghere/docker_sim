diff --git a/src/mighty/mighty.cpp b/src/mighty/mighty.cpp
index 0000000..0000000 100644
--- a/src/mighty/mighty.cpp
+++ b/src/mighty/mighty.cpp
@@ -1784,10 +1784,27 @@ bool MIGHTY::getNextGoal(state& next_goal) {
         // index i == i*dc seconds ahead; look yaw_look_ahead_time seconds
         // ahead on this same plan, clamped to the last available sample
         // (mirrors ego's clamp-to-traj_duration_ near the trajectory end).
-        size_t look_ahead_idx = std::min(
-            local_plan.size() - 1,
-            static_cast<size_t>(std::round(par_.yaw_look_ahead_time / par_.dc)));
-        getDesiredYaw(next_goal, local_plan[look_ahead_idx]);
+        //
+        // 2026-08-13：yaw_look_ahead_time从1.0秒改成5.0秒——看得更远，把
+        // 更多短期轨迹形状变化平均掉。同时补一条明确规则：如果按当前
+        // plan_算，yaw_look_ahead_time秒内就能跑到plan_末尾（意味着按
+        // 现在的速度很快就要到目标附近了），直接瞄准真正的终点G_term，
+        // 不再瞄plan_末尾那个点——plan_末尾在正常TRAVELING阶段可能只是
+        // 被水平线(horizon)截断出来的中间subgoal，不一定是G_term本身
+        // （见computeG()/par_.horizon），瞄中间点会在subgoal本身随着
+        // 每次重规划小幅漂移时带来额外的方向抖动，直接瞄真正的目标点
+        // 更稳定，也更符合"快到目标了就应该开始对准目标方向"这个直觉。
+        const double remaining_duration = (local_plan.size() - 1) * par_.dc;
+        state yaw_look_ahead_goal;
+        if (remaining_duration <= par_.yaw_look_ahead_time) {
+          getGterm(yaw_look_ahead_goal);
+        } else {
+          size_t look_ahead_idx = std::min(
+              local_plan.size() - 1,
+              static_cast<size_t>(std::round(par_.yaw_look_ahead_time / par_.dc)));
+          yaw_look_ahead_goal = local_plan[look_ahead_idx];
+        }
+        getDesiredYaw(next_goal, yaw_look_ahead_goal);
       }
     }
 
