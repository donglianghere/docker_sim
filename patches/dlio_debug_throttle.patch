diff --git a/include/dlio/odom.h b/include/dlio/odom.h
index 51641b3..d7a5e53 100755
--- a/include/dlio/odom.h
+++ b/include/dlio/odom.h
@@ -147,6 +147,11 @@ private:
   std::thread publish_keyframe_thread;
   std::thread metrics_thread;
   std::thread debug_thread;
+  // debug()原来在callbackPointCloud里每一帧点云都触发一次（雷达帧率有多快，
+  // 终端里的全屏仪表盘就刷多快，多个detached线程还会互相抢着清屏/打印，输出
+  // 经常整段乱套）。限流到最多每debug_print_period_秒打印一次。
+  double last_debug_print_time_ = 0.0;
+  const double debug_print_period_ = 1.0;
 
   // Trajectory
   std::vector<std::pair<Eigen::Vector3f, Eigen::Quaternionf>> trajectory;
diff --git a/src/dlio/odom.cc b/src/dlio/odom.cc
index c6568d7..1ae04e7 100755
--- a/src/dlio/odom.cc
+++ b/src/dlio/odom.cc
@@ -849,8 +849,15 @@ void dlio::OdomNode::callbackPointCloud(const sensor_msgs::msg::PointCloud2::Sha
   this->gicp_hasConverged = this->gicp.hasConverged();
 
   // Debug statements and publish custom DLIO message
-  this->debug_thread = std::thread( &dlio::OdomNode::debug, this );
-  this->debug_thread.detach();
+  // 限流：原来这里每一帧点云回调都新起一个detached线程打印一次全屏仪表盘，
+  // 雷达帧率有多快终端就刷多快，多个线程还会互相抢着清屏/打印导致输出乱套。
+  // 改成最多每debug_print_period_秒打印一次。
+  double now_sec = this->now().seconds();
+  if (now_sec - this->last_debug_print_time_ >= this->debug_print_period_) {
+    this->last_debug_print_time_ = now_sec;
+    this->debug_thread = std::thread( &dlio::OdomNode::debug, this );
+    this->debug_thread.detach();
+  }
 
   this->geo.first_opt_done = true;
 
