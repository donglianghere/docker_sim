   // 使用L-BFGS方法对目标函数进行优化，得到光滑、无碰撞、动力学可行、与其他无人机碰撞、结束项的轨迹。
+  // docker_sim 2026-10-13：梯度投影锁直线 —— 判断本次优化能不能锁，并记下弦方向。
+  //
+  // 为什么这么做有效：min-jerk 轨迹在**两端边界条件与航段共线**时，空间路径精确
+  // 就是直线（各轴共用同一条五次时间曲线，只差一个位移向量的缩放）；均匀 B 样条
+  // 的控制点共线 ⇒ 曲线共线（凸组合）。所以 fsm/align_start_state 把起点 v/a 投影
+  // 到航段方向之后，**初值已经是一条精确直线**，剩下的横向偏差全部来自优化器把
+  // 控制点往横向推（distance/swarm/feasibility 三项的横向梯度）。把每个控制点的
+  // 梯度投影到弦方向、横向分量清零，横向自由度就从问题里消失了：控制点只能沿线
+  // 滑动，空间路径恒等于直线，优化器退化成"只重新分配时间"（速度剖面），
+  // calcFeasibilityCost 的限速限加速照常生效。
+  //
+  // 弦取"首控制点 -> 末控制点"而不是 start_pt_->local_target_pt_：rebound 阶段
+  // end_id = cps_.size（Free end），末控制点是自由变量，但进优化之前它就是初值
+  // 多项式采到局部目标上的那一点，方向一致，而且这里拿不到 FSM 的那两个量。
+  // 航段两端等高时弦自然是水平的，z 方向自由度一并消失 —— 这就是"水平直线"。
+  //
+  // 四道门，任一不过就不锁（退回完整的 ego-planner 行为）：
+  //   ① 开关没开；② 弦太短；③ 初值本来就不共线；④ 直线在膨胀图上不通。
+  void BsplineOptimizer::setupLineLock(void)
+  {
+    lock_active_ = false;
+    lock_dir_.setZero();
+    if (!lock_to_line_)
+      return;
+
+    const int n = static_cast<int>(cps_.points.cols());
+    if (n < 2 * order_ + 1) // 控制点太少，锁了也没有自由度可谈
+      return;
+
+    const Eigen::Vector3d p0 = cps_.points.col(0);
+    Eigen::Vector3d seg = cps_.points.col(n - 1) - p0;
+    const double seg_len = seg.norm();
+    if (seg_len < lock_min_len_)
+      return;
+    const Eigen::Vector3d dir = seg / seg_len;
+
+    // ③ 初值共线性
+    double max_dev = 0.0;
+    for (int i = 0; i < n; ++i)
+    {
+      const Eigen::Vector3d d = cps_.points.col(i) - p0;
+      max_dev = std::max(max_dev, (d - dir * d.dot(dir)).norm());
+    }
+    if (max_dev > lock_max_init_dev_)
+    {
+      if (lock_report_state_ != 2)
+      {
+        printf("[lock_line] 不锁：初值不共线 max_dev=%.3f > %.3f（通常是 "
+               "fsm/align_start_state 没生效或起点横向速度超限）\n",
+               max_dev, lock_max_init_dev_);
+        lock_report_state_ = 2;
+      }
+      return;
+    }
+
+    // ④ 直线必须在膨胀图上通。判据跟 fsm/align_start_state 那段一致：锁住之后
+    //    横向避障能力为零，所以这一关是安全的全部依靠。每次优化都重算，线上一旦
+    //    出现占据就立刻不锁、退回正常规划（FSM 100 Hz，延迟一拍）。
+    if (grid_map_)
+    {
+      const double step = grid_map_->getResolution();
+      if (step > 1e-6)
+      {
+        for (double d = 0.0; d <= seg_len; d += step)
+        {
+          if (grid_map_->getInflateOccupancy(p0 + dir * d))
+          {
+            if (lock_report_state_ != 3)
+            {
+              printf("[lock_line] 不锁：直线第 %.2f/%.2f m 处被占据，退回正常规划\n",
+                     d, seg_len);
+              lock_report_state_ = 3;
+            }
+            return;
+          }
+        }
+      }
+    }
+
+    lock_dir_ = dir;
+    lock_active_ = true;
+    if (lock_report_state_ != 1)
+    {
+      printf("[lock_line] 锁住：弦长 %.2f m 方向(%.3f,%.3f,%.3f) 初值横偏 %.4f m\n",
+             seg_len, dir.x(), dir.y(), dir.z(), max_dev);
+      lock_report_state_ = 1;
+    }
+  }
+
+  // 把每个控制点的梯度投影到弦方向上，横向分量清零。
+  // 固定边界点（前 order_ 列）投不投都一样 —— 它们不在 memcpy 出去的范围里。
+  void BsplineOptimizer::projectGradToLine(Eigen::MatrixXd &grad_3D)
+  {
+    if (!lock_active_)
+      return;
+    for (Eigen::Index i = 0; i < grad_3D.cols(); ++i)
+      grad_3D.col(i) = lock_dir_ * grad_3D.col(i).dot(lock_dir_);
+  }
