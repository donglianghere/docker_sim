@@ -151,6 +156,21 @@ def generate_launch_description():
                 hw_params = yaml.safe_load(f)['mighty_node']['ros__parameters']
             parameters.update(hw_params)
 
+        # Layer an optional vehicle_profile.yaml on top, AFTER the hw_params block above
+        # (not before it -- an earlier version of this override ran before hw_params and
+        # got silently clobbered by it for any overlapping key, e.g. mass/f_min/f_max,
+        # since use_hardware=true in this docker_sim and hw_params always wins whatever
+        # runs before it). vehicle_profile.yaml is meant to be the single source of truth
+        # for physical params shared with ros2_px4_stack (same file, read via env vars in
+        # flight-stack-entrypoint.sh), so it needs to be applied last to actually be
+        # authoritative.
+        vehicle_profile = LaunchConfiguration('vehicle_profile').perform(context)
+        if vehicle_profile:
+            with open(vehicle_profile, 'r') as vf:
+                vehicle_profile_yaml = yaml.safe_load(vf)
+            vehicle_profile_params = (vehicle_profile_yaml or {}).get('mighty_node', {}).get('ros__parameters', {})
+            parameters.update(vehicle_profile_params)
