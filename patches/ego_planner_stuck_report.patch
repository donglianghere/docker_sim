+  // docker_sim 2026-09-25：规划成功/失败统一记账 +"陷住"上报，见头文件说明。
+  // 判陷住：连续失败 stuck_fail_threshold_ 次。
+  // 解陷住：要**连续成功 stuck_clear_ok_count_ 次**才算，而不是成功一次就算——
+  // 刚从膨胀区退出来那会儿飞机还贴着边界，偶尔能规划成功一次，这时候就放行
+  // 等于让它带着一条勉强的轨迹再冲进去。陷住期间还会**暂停把轨迹交给控制器**
+  // （见 callReboundReplan 里的门），飞机保持悬停，直到规划真的稳定了才起飞。
+  void EGOReplanFSM::notePlanResult(bool success)
+  {
+    if (success)
+    {
+      consecutive_plan_fail_ = 0;
+      if (planner_stuck_reported_)
+      {
+        consecutive_plan_ok_++;
+        if (consecutive_plan_ok_ >= stuck_clear_ok_count_)
+        {
+          planner_stuck_reported_ = false;
+          consecutive_plan_ok_ = 0;
+          std_msgs::msg::Bool m;
+          m.data = false;
+          planner_stuck_pub_->publish(m);
+          RCLCPP_WARN(node_->get_logger(),
+                      "[stuck] 已连续 %d 次规划成功，解除陷住状态，恢复下发轨迹",
+                      stuck_clear_ok_count_);
+        }
+      }
+      return;
+    }
+    consecutive_plan_ok_ = 0;
+    consecutive_plan_fail_++;
+    if (consecutive_plan_fail_ >= stuck_fail_threshold_ && !planner_stuck_reported_)
+    {
+      planner_stuck_reported_ = true;
+      std_msgs::msg::Bool m;
+      m.data = true;
+      planner_stuck_pub_->publish(m);
+      RCLCPP_ERROR(node_->get_logger(),
+                   "[stuck] 连续 %d 次规划失败，判定规划器陷住，已上报 planner_stuck=true"
+                   "（常见原因：飞机自身落进障碍物膨胀区，rebound_optimize 直接拒绝规划）",
+                   consecutive_plan_fail_);
+    }
+  }
