+  // docker_sim: 照mighty_node.cpp::frameAlignCallback()的模式补的——记下
+  // "把agent_id这架飞机自己局部系下的点变换到本机局部系"这个4x4齐次变换矩阵，
+  // 每次/frame_align/<own_ns>/<other_ns>更新都刷新一次，不假设它是静态不变的
+  // (UWB真值理论上会跟两机实际漂移的相对位姿同步更新)。
+  void EGOReplanFSM::frameAlignCallback(const std::shared_ptr<const geometry_msgs::msg::TransformStamped> &msg, int agent_id)
+  {
+    Eigen::Quaterniond q(msg->transform.rotation.w, msg->transform.rotation.x,
+                         msg->transform.rotation.y, msg->transform.rotation.z);
+    Eigen::Matrix4d T = Eigen::Matrix4d::Identity();
+    T.block<3, 3>(0, 0) = q.toRotationMatrix();
+    T(0, 3) = msg->transform.translation.x;
+    T(1, 3) = msg->transform.translation.y;
+    T(2, 3) = msg->transform.translation.z;
+
+    std::lock_guard<std::mutex> lock(frame_align_mutex_);
+    frame_align_transforms_[agent_id] = T;
+    if (!frame_align_received_[agent_id])
+    {
+      frame_align_received_[agent_id] = true;
+      RCLCPP_INFO(node_->get_logger(), "Received first frame alignment for agent %d", agent_id);
+    }
+  }
+
+  // pos_pts是3xN矩阵，每一列是B样条的一个控制点(sender_drone_id局部系下的
+  // 真实空间坐标，不是多项式系数)——B样条控制点在仿射变换下具有仿射不变性，
+  // 所以直接对每一列做p' = R*p + t就等价于把整条曲线变换过去，不需要像mighty
+  // 的PieceWiseQuinticPol那样区分"旋转项"和"常数项"分开处理。
+  bool EGOReplanFSM::applyFrameAlignTransform(Eigen::MatrixXd &pos_pts, int sender_drone_id)
+  {
+    Eigen::Matrix4d T;
+    {
+      std::lock_guard<std::mutex> lock(frame_align_mutex_);
+      auto it = frame_align_transforms_.find(sender_drone_id);
+      if (it == frame_align_transforms_.end() || !frame_align_received_[sender_drone_id])
+      {
+        return false;
+      }
+      T = it->second;
+    }
+
+    Eigen::Matrix3d R = T.block<3, 3>(0, 0);
+    Eigen::Vector3d t = T.block<3, 1>(0, 3);
+    for (int j = 0; j < pos_pts.cols(); j++)
+    {
+      pos_pts.col(j) = R * pos_pts.col(j) + t;
+    }
+    return true;
+  }
+
+  // docker_sim: 照mighty_node.cpp::publishSelfAsStaticObstacleCallback()的
+  // 模式补的心跳——不管当前FSM在哪个状态(WAIT_TARGET/EXEC_TRAJ/...都一样)，
+  // 每次都把"当前位置"打包成一条所有控制点重合的B样条广播出去，让一架
+  // 已经很久没有成功重规划(因而也很久没有真的调用publishSwarmTrajs())的
+  // 飞机，不会从别人的swarm_trajs_buf_里彻底消失。
+  //
+  // 具体构造：ego_planner的B样条是标准的p阶(这里p=order=3)均匀B样条，节点
+  // 向量的生成公式(见uniform_bspline.cpp::setUniformBspline())是
+  // knots[i] = (i-order)*interval，跟控制点个数、interval取值本身无关——
+  // 只要控制点全部相同，不管怎么取值，曲线在整个定义域上算出来都是同一个
+  // 点(evaluateDeBoor内部还会把参数钳到[u_(p_), u_(m_-p_)]范围内，进一步
+  // 保证不会有越界访问)，这里不需要现实轨迹那种"贴着实际运动学"的knot
+  // 设计，只要凑够receiver端(BroadcastBsplineCallback)算出来的duration_
+  // 足够长即可。receiver端对order为奇数(3是奇数)时用
+  // duration_=knots[knots.size()-3]，num_ctrl_pts=10个控制点、
+  // interval=7.5秒时，knots.size()=10+3+1=14，
+  // duration_=knots[11]=(11-3)*7.5=60秒——跟mighty那边"60秒/1Hz心跳"用的
+  // 是同一个安全余量(远大于1秒的心跳间隔，网络抖动/丢一两帧不会立刻过期)。
+  void EGOReplanFSM::publishSelfAsStaticObstacle()
+  {
+    if (!have_odom_)
+      return; // 还没收到第一帧里程计，不知道自己在哪，这次心跳先跳过
+
+    constexpr int order = 3;
+    constexpr int num_ctrl_pts = 10;
+    constexpr double interval = 7.5; // 秒
+
+    traj_utils::msg::Bspline bspline;
+    bspline.order = order;
+    bspline.drone_id = planner_manager_->pp_.drone_id;
+    bspline.traj_id = -1; // 哨兵值，标识"这是心跳，不是真实重规划"，方便调试时区分；
+                           // 接收端(BroadcastBsplineCallback/checkCollision)不读这个字段
+    bspline.start_time = node_->get_clock()->now();
+
+    bspline.pos_pts.resize(num_ctrl_pts);
+    for (int i = 0; i < num_ctrl_pts; i++)
+    {
+      geometry_msgs::msg::Point p;
+      p.x = odom_pos_(0);
+      p.y = odom_pos_(1);
+      p.z = odom_pos_(2);
+      bspline.pos_pts[i] = p;
+    }
+
+    int num_knots = num_ctrl_pts + order + 1;
+    bspline.knots.resize(num_knots);
+    for (int i = 0; i < num_knots; i++)
+    {
+      bspline.knots[i] = (double)(i - order) * interval;
+    }
+
+    broadcast_bspline_pub_->publish(bspline);
+  }
