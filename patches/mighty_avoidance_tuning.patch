diff --git a/config/hw_mighty.yaml b/config/hw_mighty.yaml
index f320ed4..cbfba6a 100644
--- a/config/hw_mighty.yaml
+++ b/config/hw_mighty.yaml
@@ -45,7 +45,7 @@ mighty_node:
         global_planner_heuristic_weight: 2.0         # [-] Weight for the heuristic in the global planner
         num_N: 5                                    # [-] Number of segments
         max_dist_vertexes: 2.0                      # [m] Maximum distance between two consecutive vertexes
-        w_unknown: 0.0                              # [-] Weight for the unknown cells in the global planner
+        w_unknown: 0.4                              # [-] Weight for the unknown cells in the global planner
         w_align: 0.0                              # [-] Weight for the alignment with the initial velocity in the global planner
         decay_len_cells: 100.0                     # [-] Decay length for the alignment with the initial velocity in the global planner
         w_side: 0.0                                # [-] Weight for the side tie-break in the global planner
@@ -67,7 +67,7 @@ mighty_node:
         v_max: 1.0                                       # [m/s]  max velocity
         a_max: 3.0                                       # [m/s2] max acceleration
         j_max: 5.0                                       # [m/s3] max jerk
-        dynamic_weight: 1e+1                        # [-] Weight of the obstacles and agents distance in the optimization
+        dynamic_weight: 1e+2                        # [-] Weight of the obstacles and agents distance in the optimization
         time_weight: 5e+2                            # [-] Weight of the time cost in the optimization
         pos_anchor_weight: 0.0                      # [-] Weight of the position anchors in the optimization
         stat_weight: 1e+3                           # [-] Weight of the static obstacles in the optimization
@@ -79,18 +79,33 @@ mighty_node:
         dyn_constr_tilt_weight: 0.0                 # [-] Weight of the tilt constraints violation in the optimization
         dyn_constr_thrust_weight: 0.0               # [-] Weight of the thrust constraints violation in the optimization
         num_dyn_obst_samples: 10                    # [-] Number of samples for the dynamic obstacles in the optimization
-        planner_Co: 0.3                              # [-] Collision clearance thresh for static obstacles in the optimization
+        planner_Co: 0.6                              # [-] Collision clearance thresh for static obstacles in the optimization
         planner_Cw: 3.0                             # [-] Collision clearance thresh for dynamic obstacles in the optimization
         drone_bbox: [1.2, 1.2, 1.2]                 # [m] Size of the bounding box for the obstacles
-        goal_radius: 0.5                           # [m] Radius of the goal
+        goal_radius: 0.3                           # [m] Radius of the goal
         goal_seen_radius: 2.0                       # [m] Radius of the goal that the drone can see and stop replanning. Note that if this number is too small, the trajectory planning becomes extremely difficult.
         integral_resolution: 8
         hinge_mu: 1e-2
         omega_max: 0.10472 # [rad/s] Maximum angular velocity (6 deg/s)
         tilt_max_rad: 0.610865 # [rad] Maximum tilt angle (35 deg)
-        f_min: 2.0                        # Minimum thrust
-        f_max: 12.0                        # Maximum thrust
-        mass: 1.0                         # [kg] Mass of the drone
+        f_min: 3.0                        # [N] Minimum thrust
+        f_max: 26.0                        # [N] Maximum thrust -- real physical ceiling is
+                                            # 4 rotors * motorConstant(5.84e-6) *
+                                            # maxRotVelocity(1100)^2 = 4*7.0664N = 28.27N
+                                            # (iris.sdf.jinja), 26.0 leaves ~8% headroom below
+                                            # that instead of assuming the motors can sustain
+                                            # the theoretical max continuously
+        mass: 1.935                       # [kg] Mass of the drone -- real total mass: iris
+                                            # body 1.535kg (iris.sdf.jinja base_link+imu_link+
+                                            # 4 rotors) + mid360/IMU payload 0.4kg
+                                            # (gen_iris_mid360_sdf.py mid360_link mass) =
+                                            # 1.935kg. Previous value (1.0kg) understated real
+                                            # mass by ~94%, meaning the planner's thrust-
+                                            # feasibility constraints thought there was far more
+                                            # margin than actually exists -- real hover thrust
+                                            # is 1.935*9.81=18.98N, only ~1.4x under the 26N
+                                            # ceiling above, not the ~5x margin the old 1.0kg/
+                                            # 12N pairing implied.
         g: 9.81                        # [m/s^2] Gravitational acceleration
         fopt_threshold: 10000.0               # [-] Threshold for the fopt to consider the optimization successful
 
@@ -118,7 +133,20 @@ mighty_node:
 
         # Yaw-related parameters
         alpha_filter_dyaw: 0.1                 # [-] Filter parameter for dyaw, \in [0,1]. Higher--> More aggressive filtering
-        w_max: 1.0                              # [rd/s] Maximum angular velocity. ~4.0 for Hardware
+        w_max: 0.8                              # [rd/s] Maximum angular velocity. ~4.0 for Hardware
+        # 0.8 rd/s (~45.8 deg/s) matches PX4's MPC_YAWRAUTO_MAX=45deg/s cap
+        # (see px4_iris_mpc_yawrate_max.patch). Was 3.0 rd/s (~172 deg/s) --
+        # nearly 4x PX4's real tracking rate -- which let mighty command a
+        # yaw rate the vehicle physically could not follow, especially right
+        # after a mid-flight goal redirect (new term_goal while still moving
+        # toward the old one): HGP/L-BFGS replanning succeeds every cycle in
+        # this scenario (confirmed via debug_verbose logs, "Replanning
+        # succeeded" printed continuously, zero FAILED), so the resulting
+        # trajectory is not a planner bug -- it is a real maneuver the
+        # optimizer deems solvable but the real vehicle cannot track,
+        # causing genuine attitude loss of control (not a numerical
+        # near-zero-vector artifact like the z_B/y_B/getDesiredYaw guards
+        # elsewhere in this patch chain).
         yaw_spinning_threshold: 10000              # [-] if the planner keeps failing more than this number, we switch to the spinning mode
         yaw_spinning_dyaw: 1.0                  # [rd/s] Spinning dyaw
 
