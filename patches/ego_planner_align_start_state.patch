   static double g_poly_reset_period_s = 0.0;
   static double g_last_poly_reset_s = 0.0;
 
+  // docker_sim: 起点速度/加速度对齐到"起点->局部目标"方向用的开关。
+  static bool g_align_start_state = false;
+  static double g_align_max_lat_v = 0.5;
