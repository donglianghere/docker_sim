+  // 位姿彻底自由发散。用this->gicp.num_correspondences（NanoGICP这次实际
+  // 配对上的点数）识破这种伪装——真正配准成功时这个数字是几百，退化到
+  // 对着不存在的匹配空转时会是0或者极少。
+  if (this->gicp.num_correspondences < this->gicp_min_num_points_) {
+    if (this->scan_stamp - this->last_gicp_lost_print_time_ >= 1.0) {
