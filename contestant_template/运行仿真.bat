@echo off
chcp 65001 >nul
REM =============================================================================
REM  运行仿真.bat —— 双击我，或者在命令提示符/PowerShell里运行
REM =============================================================================
REM
REM 这个脚本做的事情很简单：把同一个文件夹里的"我的任务.py"丢进仿真环境里跑
REM 一遍，你会看到中文的飞行进度提示（起飞/飞行中/降落…）。
REM
REM 你不需要看懂这个脚本里面在做什么，正常情况下你也不需要改这个文件——
REM 你只需要改"我的任务.py"里的坐标数字，然后重新双击这个脚本。
REM
REM 用法：
REM   1. 把这个文件夹（包含"运行仿真.bat"和"我的任务.py"）放在你自己的电脑上；
REM   2. 先确认已经装好 Docker Desktop for Windows，并且已经打开、正在运行
REM      （下面脚本会自动检查是否装了docker命令，检查不过会告诉你怎么办）；
REM   3. 双击这个文件即可，或者在命令提示符/PowerShell里cd到这个文件夹后
REM      执行：运行仿真.bat
REM   4. 仿真那一侧（另外有一套仿真环境，通常由赛事方/助教已经启动好）需要
REM      已经在运行，这个脚本只负责起"你的任务程序"，不负责起飞机仿真本身。
REM
REM ⚠️ 一个已知的Windows平台限制，先坦白说清楚（不是你的代码有问题）：
REM   下面用到的 --network host 这个参数，在Linux/macOS上能让容器和仿真环境
REM   共享同一套网络；但Docker Desktop for Windows的底层是一个Linux虚拟机
REM   （WSL2或Hyper-V），--network host 在这种架构下支持非常有限，某些版本
REM   干脆直接忽略这个参数、退回默认的"容器有自己独立网络"模式——这种情况下
REM   容器可能连不上仿真环境的ROS2话题，报错也不会直接告诉你"是网络模式的问题"。
REM   如果你在Windows上运行这个脚本，任务代码卡在"等待连接/等待起飞确认"
REM   一直没反应，很可能就是这个原因，目前没有一个能在这个脚本里自动修好的
REM   办法——建议优先用Linux/macOS跑，或者用Windows上的WSL2（在WSL2的Ubuntu
REM   环境里执行"运行仿真.sh"那个版本，不是这个.bat），这两种情况下
REM   --network host 是正常生效的。具体是否受影响，以及有没有更好的绕过办法，
REM   请留意赛事方后续说明，这是Docker Desktop for Windows本身的已知限制，
REM   不是"我的任务.py"或者你的代码写错了。
REM =============================================================================

setlocal

REM ---------------------------------------------------------------------------
REM 不管你是从哪个目录双击/调用这个脚本，都先切到脚本自己所在的目录，保证
REM 一会儿挂载给容器的是"这个文件夹"本身（跟 运行仿真.sh 用 dirname 的思路
REM 一致，Windows batch下用 %~dp0 这个内置变量代表"这个.bat文件所在的目录"）。
REM ---------------------------------------------------------------------------
cd /d "%~dp0"

set TASK_FILE=我的任务.py
set IMAGE_NAME=contestant-sdk:latest

echo ======================================================================
echo  正在检查运行环境……
echo ======================================================================

REM ---------------------------------------------------------------------------
REM 检查1：docker 命令本身有没有装（PATH里能不能找到）
REM ---------------------------------------------------------------------------
where docker >nul 2>nul
if errorlevel 1 (
    echo.
    echo 【没有检测到 Docker】
    echo 这台电脑上还没有安装 Docker，运行仿真任务需要先装好 Docker Desktop for Windows。
    echo   下载地址：https://www.docker.com/products/docker-desktop/  （占位链接，具体以赛事方通知为准）
    echo 装好之后，重新双击这个脚本即可。
    echo.
    pause
    exit /b 1
)

REM ---------------------------------------------------------------------------
REM 检查2：docker 命令装了，但 Docker 服务本身有没有在运行
REM   （Docker Desktop还没打开、或者刚开机没启动完），docker info 会失败。
REM ---------------------------------------------------------------------------
docker info >nul 2>nul
if errorlevel 1 (
    echo.
    echo 【Docker 没有启动】
    echo 检测到已经安装了 Docker，但它现在没有在运行。
    echo   请先打开「Docker Desktop」这个应用程序（开始菜单里搜索"Docker Desktop"），
    echo   等它左下角图标变成绿色、显示「Running」之后，再重新运行这个脚本。
    echo   首次启动可能需要等待1-2分钟，请耐心等一下再重试。
    echo.
    pause
    exit /b 1
)

REM ---------------------------------------------------------------------------
REM 检查3：选手运行环境镜像有没有准备好
REM ---------------------------------------------------------------------------
docker image inspect %IMAGE_NAME% >nul 2>nul
if errorlevel 1 (
    echo.
    echo 【找不到运行环境镜像：%IMAGE_NAME%】
    echo 还没有准备好名为 %IMAGE_NAME% 的运行环境，请按照赛事方提供的说明
    echo 先获取这个镜像（比如用 docker load 加载赛事方提供的镜像文件，
    echo 或者 docker pull 从赛事方指定的镜像仓库拉取），获取成功后重新运行
    echo 这个脚本即可。
    echo.
    pause
    exit /b 1
)

REM ---------------------------------------------------------------------------
REM 检查4：任务代码文件是否存在（提醒选手别改了文件名/位置）
REM ---------------------------------------------------------------------------
if not exist "%TASK_FILE%" (
    echo.
    echo 【找不到任务代码文件：%TASK_FILE%】
    echo 请确认「%TASK_FILE%」这个文件跟这个脚本放在同一个文件夹里，
    echo 而且文件名没有被改动过（包括中文字符）。
    echo.
    pause
    exit /b 1
)

echo 环境检查通过，开始运行你的任务代码（%TASK_FILE%）……
echo ======================================================================
echo.

REM ---------------------------------------------------------------------------
REM 真正的运行命令（含义跟 运行仿真.sh 里的完全一样，只是Windows下用 %cd%
REM 代表当前目录，注意上面已经 cd /d 到脚本所在目录了，所以这里的 %cd% 就是
REM 这个文件夹本身）：
REM   --rm            任务跑完自动清理这个容器，不会越堆越多垃圾容器
REM   --network host  让容器和仿真环境共享同一套网络（见脚本最上面那段
REM                    关于Windows下这个参数已知限制的说明）
REM   -v "%cd%":/workspace   把当前这个文件夹共享给容器，容器里写的东西
REM                    实际上就是写在你电脑上这个文件夹里
REM ---------------------------------------------------------------------------
docker run --rm --network host -v "%cd%":/workspace %IMAGE_NAME% python3 /workspace/%TASK_FILE%

set RUN_STATUS=%errorlevel%

echo.
echo ======================================================================
if %RUN_STATUS%==0 (
    echo  任务代码已运行结束。
) else (
    echo  任务代码运行时出现了错误（退出码：%RUN_STATUS%），请往上翻看看具体是
    echo  哪一行的中文提示，或者把完整输出发给助教帮忙看看。
    echo  如果输出里完全没有中文进度提示、直接卡住或者报网络相关的错误，
    echo  优先检查一下是不是本文件开头提到的 --network host 在Windows上的
    echo  已知限制导致的。
)
echo ======================================================================

pause
endlocal
